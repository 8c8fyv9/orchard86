+static void __attribute__((target("sha"), noinline))
+sha256_x86_round(void *vd, const void *vn, const void *vm, bool h2)
+{
+    uint32_t a[4], e[4];
+    __m128i x, y, w, result;
+
+    memcpy(a, h2 ? vn : vd, sizeof(a));
+    memcpy(e, h2 ? vd : vn, sizeof(e));
+    x = _mm_set_epi32(a[0], a[1], e[0], e[1]);
+    y = _mm_set_epi32(a[2], a[3], e[2], e[3]);
+    w = _mm_loadu_si128(vm);
+    y = _mm_sha256rnds2_epu32(y, x, w);
+    x = _mm_sha256rnds2_epu32(x, y, _mm_srli_si128(w, 8));
+    result = h2 ? _mm_unpacklo_epi64(x, y) : _mm_unpackhi_epi64(x, y);
+    _mm_storeu_si128(vd, _mm_shuffle_epi32(result, 0xb1));
+}
+
+static void __attribute__((target("sha"), noinline))
+sha256_x86_schedule(void *vd, const void *vn, const void *vm)
+{
+    __m128i d = _mm_loadu_si128(vd), m = _mm_loadu_si128(vm);
+
+    if (vn) {
+        __m128i n = _mm_loadu_si128(vn);
+        __m128i add = _mm_or_si128(_mm_srli_si128(n, 4),
+                                  _mm_slli_si128(m, 12));
+        d = _mm_sha256msg2_epu32(_mm_add_epi32(d, add), m);
+    } else {
+        d = _mm_sha256msg1_epu32(d, m);
+    }
+    _mm_storeu_si128(vd, d);
+}
