+static void reims_console_create_one(VMAppleMachineState *vms, unsigned index)
+{
+    VMAppleReimsScreen *screen = &vms->reims_screens[index];
+
+    screen->machine = vms;
+    screen->index = index;
+    qemu_event_init(&screen->reims_display_done, false);
+    qemu_mutex_init(&screen->reims_rb_lock);
+    qemu_cond_init(&screen->reims_rb_cond);
+    screen->reims_rb_started = true;
+    qemu_thread_create(&screen->reims_rb_thread, "reims-readback",
+                       reims_readback_thread, screen, QEMU_THREAD_JOINABLE);
+    screen->reims_console = qemu_graphic_console_create(NULL, index,
+                                                        &reims_console_ops, screen);
+}
+
+/*
+ * VNC and other display listeners bind to a console at display-init time, which
+ * runs before the guest first touches the GPU.  Create the consoles during
+ * machine init so the serialized frame callbacks reach a bound listener.
+ */
+static void reims_console_preinit(VMAppleMachineState *vms)
+{
+    for (unsigned i = 0; i < vms->reims_display_count &&
+                         i < RVG_MAX_DISPLAY_PORTS; i++) {
+        if (!vms->reims_screens[i].reims_console) {
+            reims_console_create_one(vms, i);
+        }
+    }
+}
+static void reims_exit(Notifier *notifier, void *data)
+{
+    VMAppleMachineState *vms = container_of(notifier, VMAppleMachineState, reims_exit);
+    if (qatomic_read(&vms->reims_stopping)) {
+        return;
+    }
+    qatomic_set(&vms->reims_stopping, true);
+    /* Normal cleanup holds BQL; display callbacks may need it to drain. */
+    bql_unlock();
+    for (unsigned i = 0; i < vms->reims_active_screens; i++) {
+        rvg_display_release(vms->reims_screens[i].reims_display);
+    }
+    for (unsigned i = 0; i < vms->reims_active_screens; i++) {
+        VMAppleReimsScreen *screen = &vms->reims_screens[i];
+        qemu_event_wait(&screen->reims_display_done);
+        if (screen->reims_rb_started) {
+            qemu_mutex_lock(&screen->reims_rb_lock);
+            screen->reims_rb_stop = true;
+            qemu_cond_broadcast(&screen->reims_rb_cond);
+            qemu_mutex_unlock(&screen->reims_rb_lock);
+            qemu_thread_join(&screen->reims_rb_thread);
+            screen->reims_rb_started = false;
+            qemu_cond_destroy(&screen->reims_rb_cond);
+            qemu_mutex_destroy(&screen->reims_rb_lock);
+        }
+        for (unsigned j = 0; j < 2; j++) {
+            if (screen->reims_targets[j]) {
+                rvg_frame_target_release(screen->reims_targets[j]);
+                screen->reims_targets[j] = NULL;
+                screen->reims_target_widths[j] = 0;
+                screen->reims_target_heights[j] = 0;
+            }
+        }
+        g_clear_pointer(&screen->reims_pixels, g_free);
+        g_clear_pointer(&screen->reims_prev_pixels, g_free);
+        screen->reims_pixels_size = 0;
+        screen->reims_prev_valid = false;
+    }
+    rvg_device_release(vms->reims_device);
+    qemu_event_wait(&vms->reims_device_done);
+    rvg_iosurface_device_release(vms->reims_surface);
+    qemu_event_wait(&vms->reims_surface_done);
+    /* Optional additive API: old libraries retain their historical cleanup path. */
+    uint32_t (*terminal_shutdown)(void) = dlsym(RTLD_DEFAULT, "rvg_terminal_shutdown");
+    uint32_t (*terminal_wait)(uint64_t) =
+        dlsym(RTLD_DEFAULT, "rvg_terminal_shutdown_wait");
+    if (terminal_wait || terminal_shutdown) {
+        uint32_t terminal = terminal_wait
+            ? terminal_wait(vms->reims_terminal_wait_ns) : terminal_shutdown();
+        /* Terminal results are not RvgStatus: calling status_message is now illegal. */
+        if (terminal != 0) {
+            error_report("Reims terminal backend shutdown incomplete: result=%u", terminal);
+            exit(EXIT_FAILURE);
+        }
+        info_report("Reims terminal backend shutdown complete");
+    } else {
+        info_report("Reims library has no explicit terminal shutdown API");
+    }
+    bql_lock();
+    for (unsigned i = 0; i < vms->reims_active_screens; i++) {
+        VMAppleReimsScreen *screen = &vms->reims_screens[i];
+        if (screen->reims_cursor) {
+            cursor_unref(screen->reims_cursor);
+            screen->reims_cursor = NULL;
+        }
+        qemu_event_destroy(&screen->reims_display_done);
+    }
+    qemu_bh_delete(vms->reims_bh);
+    qemu_event_destroy(&vms->reims_device_done);
+    qemu_event_destroy(&vms->reims_surface_done);
+    info_report("Reims callbacks drained and backend released");
+}
