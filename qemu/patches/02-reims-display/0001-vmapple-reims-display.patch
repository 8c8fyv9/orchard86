+/* Bounded observer; independent switch permits one handled-prefix completion. */
+static void gfx_probe_fifo(VMAppleMachineState *vms, uint32_t producer)
+{
+    hwaddr base = ((uint64_t)vms->gfx_probe_fifo_page << 14) + 16384;
+    uint32_t capacity = vms->gfx_probe_fifo_size;
+
+    while (vms->gfx_probe_headers < 8 &&
+           vmapple_gfx_probe_span(capacity, vms->gfx_probe_cursor,
+                                  producer, 12)) {
+        uint8_t header[12];
+        VMAppleGfxProbeHeader decoded;
+        bool ok, handled = false;
+        hwaddr address = base + vms->gfx_probe_cursor;
+        MemoryRegionSection section = memory_region_find(get_system_memory(),
+                                                         address, sizeof(header));
+
+        ok = section.mr && memory_region_is_ram(section.mr) &&
+             int128_get64(section.size) >= sizeof(header) &&
+             address_space_read(&address_space_memory, address,
+                                MEMTXATTRS_UNSPECIFIED, header,
+                                sizeof(header)) == MEMTX_OK;
+        if (section.mr) {
+            memory_region_unref(section.mr);
+        }
+        if (!ok) {
+            return;
+        }
+        if (!vmapple_gfx_probe_decode(header, sizeof(header),
+                                     producer - vms->gfx_probe_cursor,
+                                     &decoded) ||
+            !vmapple_gfx_probe_span(capacity, vms->gfx_probe_cursor,
+                                    producer, decoded.length)) {
+            return;
+        }
+        if (decoded.opcode == 56) {
+            uint8_t payload[16];
+            VMAppleGfxProbeAddressSpace space;
+            uint32_t position;
+            bool valid = false;
+
+            if (vmapple_gfx_probe_payload(&decoded, 0, sizeof(payload),
+                                          &position) &&
+                gfx_probe_ram_span(address + position, sizeof(payload)) &&
+                address_space_read(&address_space_memory, address + position,
+                                   MEMTXATTRS_UNSPECIFIED, payload,
+                                   sizeof(payload)) == MEMTX_OK &&
+                vmapple_gfx_probe_address_space(&decoded, payload,
+                                                sizeof(payload), &space) &&
+                gfx_probe_ram_span(space.root_address, 16384)) {
+                unsigned id = space.id;
+                VMAppleGfxProbeAddressSpace *old =
+                    &vms->gfx_probe_address_spaces[id];
+
+                if (!vms->gfx_probe_address_space_valid[id] ||
+                    (old->root_address == space.root_address &&
+                     old->extent == space.extent && old->flag == space.flag)) {
+                    *old = space;
+                    vms->gfx_probe_address_space_valid[id] = true;
+                    valid = true;
+                }
+            }
+            handled = valid;
+            trace_vmapple_gfx_address_space(valid);
+        }
+        if (decoded.opcode == 51) {
+            uint8_t payload[12];
+            VMAppleGfxProbeHeap heap;
+            uint32_t position;
+            bool valid =
+                vmapple_gfx_probe_payload(&decoded, 0, sizeof(payload),
+                                          &position) &&
+                gfx_probe_ram_span(address + position, sizeof(payload)) &&
+                address_space_read(&address_space_memory, address + position,
+                                   MEMTXATTRS_UNSPECIFIED, payload,
+                                   sizeof(payload)) == MEMTX_OK &&
+                vmapple_gfx_probe_heap(&decoded, payload, sizeof(payload),
+                                       &heap) &&
+                vmapple_gfx_probe_heap_register(vms->gfx_probe_heaps,
+                    vms->gfx_probe_address_space_valid, &heap);
+
+            bool mapped = valid && gfx_probe_validate_heap(vms, &heap);
+
+            /* Association registration does not execute or dereference heap. */
+            handled = valid;
+            trace_vmapple_gfx_heap(valid);
+            trace_vmapple_gfx_heap_mapping(mapped);
+        }
+        if (decoded.opcode == 58) {
+            uint8_t payload[12];
+            VMAppleGfxProbeQuery query;
+            uint32_t position;
+            bool valid = false;
+
+            vms->gfx_probe_query_pending = false;
+            memset(&vms->gfx_probe_pending_query, 0,
+                   sizeof(vms->gfx_probe_pending_query));
+            if (vmapple_gfx_probe_payload(&decoded, 0, sizeof(payload),
+                                           &position) &&
+                gfx_probe_ram_span(address + position, sizeof(payload)) &&
+                address_space_read(&address_space_memory, address + position,
+                                   MEMTXATTRS_UNSPECIFIED, payload,
+                                   sizeof(payload)) == MEMTX_OK &&
+                vmapple_gfx_probe_query(&decoded, payload, sizeof(payload),
+                                        &query) &&
+                gfx_probe_ram_span(query.destination_page,
+                                   query.response_size)) {
+                vms->gfx_probe_pending_query = query;
+                vms->gfx_probe_query_pending = true;
+                valid = true;
+                if (vms->gfx_probe_response_write) {
+                    bool verified = gfx_probe_write_empty_info(vms, &query);
+
+                    handled = verified;
+
+                    trace_vmapple_gfx_response_write(
+                        vms->gfx_probe_response_saved, verified);
+                }
+            }
+            trace_vmapple_gfx_query_pending(valid);
+        }
+        trace_vmapple_gfx_fifo_probe(producer, ldl_le_p(header),
+                                    decoded.length, decoded.tag);
+        /* Sample no more than 32 payload bytes per bounded request. */
+        for (uint32_t offset = 0; offset < 32; offset += 4) {
+            uint32_t position;
+            uint8_t word[4];
+            MemoryRegionSection payload_section;
+            bool readable;
+
+            if (!vmapple_gfx_probe_payload(&decoded, offset, sizeof(word),
+                                           &position)) {
+                break;
+            }
+            payload_section = memory_region_find(get_system_memory(),
+                                                 address + position,
+                                                 sizeof(word));
+            readable = payload_section.mr &&
+                       memory_region_is_ram(payload_section.mr) &&
+                       int128_get64(payload_section.size) >= sizeof(word) &&
+                       address_space_read(&address_space_memory,
+                                          address + position,
+                                          MEMTXATTRS_UNSPECIFIED, word,
+                                          sizeof(word)) == MEMTX_OK;
+            if (payload_section.mr) {
+                memory_region_unref(payload_section.mr);
+            }
+            if (!readable) {
+                break;
+            }
+            trace_vmapple_gfx_payload_probe(decoded.opcode, offset,
+                                            ldl_le_p(word));
+            if (decoded.opcode == 48 && decoded.length == 16 &&
+                !decoded.metadata_count && offset == 0 &&
+                vms->gfx_probe_shared_page) {
+                uint32_t channel_offset;
+                uint32_t id = ldl_le_p(word);
+                uint8_t control[20];
+                hwaddr shared = (uint64_t)vms->gfx_probe_shared_page << 14;
+                MemoryRegionSection cs;
+
+                if (!vmapple_gfx_probe_channel(id, &channel_offset)) {
+                    break;
+                }
+                cs = memory_region_find(get_system_memory(),
+                                        shared + channel_offset,
+                                        sizeof(control));
+                if (cs.mr && memory_region_is_ram(cs.mr) &&
+                    int128_get64(cs.size) >= sizeof(control) &&
+                    address_space_read(&address_space_memory,
+                                       shared + channel_offset,
+                                       MEMTXATTRS_UNSPECIFIED, control,
+                                       sizeof(control)) == MEMTX_OK) {
+                    bool registered = vmapple_gfx_probe_register(
+                        vms->gfx_probe_channels, id, control, sizeof(control));
+
+                    bool mapped = registered && gfx_probe_map_first_page(
+                        &vms->gfx_probe_channels[id - 1]);
+
+                    handled = mapped && id == vms->gfx_probe_root_prefix.count - 1;
+                    trace_vmapple_gfx_channel_register(id, registered);
+                    trace_vmapple_gfx_channel_mapping(id, mapped);
+                    trace_vmapple_gfx_channel_probe(id, ldl_le_p(control),
+                        ldl_le_p(control + 4), ldl_le_p(control + 8),
+                        ldl_le_p(control + 12), ldl_le_p(control + 16));
+                }
+                if (cs.mr) {
+                    memory_region_unref(cs.mr);
+                }
+            }
+        }
+        bool candidate = vmapple_gfx_probe_root_prefix(
+            &vms->gfx_probe_root_prefix, &decoded, handled);
+
+        if (candidate && vms->gfx_probe_root_complete) {
+            bool verified = gfx_probe_complete_root(vms);
+
+            trace_vmapple_gfx_root_complete(vms->gfx_probe_stamp_saved, verified,
+                                            vms->gfx_probe_consumer);
+        }
+        trace_vmapple_gfx_root_candidate(candidate,
+                                         vms->gfx_probe_root_prefix.failed);
+        vms->gfx_probe_headers++;
+        vms->gfx_probe_cursor += decoded.length;
+    }
+}
+
+/* Metadata registration only; no resource execution or completion. */
+static bool gfx_probe_register_task_command(VMAppleMachineState *vms,
+    const VMAppleGfxProbeHeader *header, uint64_t address)
+{
+    uint8_t payload[16];
+    uint32_t position, size;
+
+    if (header->opcode != 56 && header->opcode != 51) {
+        return false;
+    }
+    size = header->opcode == 56 ? 16 : 12;
+    if (!vmapple_gfx_probe_payload(header, 0, size, &position) ||
+        !gfx_probe_ram_span(address + position, size) ||
+        address_space_read(&address_space_memory, address + position,
+            MEMTXATTRS_UNSPECIFIED, payload, size) != MEMTX_OK) {
+        return false;
+    }
+    if (header->opcode == 56) {
+        VMAppleGfxProbeAddressSpace space;
+        VMAppleGfxProbeAddressSpace *old;
+
+        if (!vmapple_gfx_probe_address_space(header, payload, size, &space) ||
+            !gfx_probe_ram_span(space.root_address, 16384)) {
+            return false;
+        }
+        old = &vms->gfx_probe_address_spaces[space.id];
+        if (vms->gfx_probe_address_space_valid[space.id] &&
+            (old->root_address != space.root_address ||
+             old->extent != space.extent || old->flag != space.flag)) {
+            return false;
+        }
+        *old = space;
+        vms->gfx_probe_address_space_valid[space.id] = true;
+        return true;
+    } else {
+        VMAppleGfxProbeHeap heap;
+
+        return vmapple_gfx_probe_heap(header, payload, size, &heap) &&
+            vmapple_gfx_probe_heap_register(vms->gfx_probe_heaps,
+                vms->gfx_probe_address_space_valid, &heap);
+    }
+}
+
+/* Writable RAM only, with original bytes retained by the caller. */
+static bool gfx_probe_save_ram(hwaddr address, uint8_t *original, size_t size)
+{
+    MemoryRegionSection section = memory_region_find(get_system_memory(),
+                                                    address, size);
+    bool writable = section.mr && memory_region_is_ram(section.mr) &&
+                    !memory_region_is_rom(section.mr) && !section.readonly &&
+                    int128_get64(section.size) >= size;
+
+    if (section.mr) {
+        memory_region_unref(section.mr);
+    }
+    return writable && address_space_read(&address_space_memory, address,
+        MEMTXATTRS_UNSPECIFIED, original, size) == MEMTX_OK;
+}
+
+static bool gfx_probe_write_verify(hwaddr address, const uint8_t *bytes,
+                                   size_t size)
+{
+    uint8_t check[32];
+
+    return size <= sizeof(check) &&
+        address_space_write(&address_space_memory, address,
+            MEMTXATTRS_UNSPECIFIED, bytes, size) == MEMTX_OK &&
+        address_space_read(&address_space_memory, address,
+            MEMTXATTRS_UNSPECIFIED, check, size) == MEMTX_OK &&
+        memcmp(bytes, check, size) == 0;
+}
+
+/* Register a disconnected display: no invented modes or rendering features. */
+/* Announce a published timing only after guest enables mode events. */
+static bool gfx_probe_display_event_ready(VMAppleMachineState *vms)
+{
+    uint32_t enabled;
+    uint8_t pending[4];
+    uint64_t address = vms->gfx_probe_display_state + 256;
+
+    if (!vms->gfx_probe_display_event || !vms->gfx_probe_display_mode ||
+        !vms->gfx_probe_display_done || vms->gfx_probe_display_event_sent ||
+        !gfx_probe_read_entry(NULL, address + 4, &enabled) || !(enabled & 4) ||
+        !gfx_probe_save_ram(address, vms->gfx_probe_display_event_original, 4)) {
+        return false;
+    }
+    stl_le_p(pending, ldl_le_p(vms->gfx_probe_display_event_original) | 4);
+    if (!gfx_probe_write_verify(address, pending, sizeof(pending))) {
+        return false;
+    }
+    vms->gfx_probe_display_event_sent = true;
+    trace_vmapple_gfx_display_event();
+    return true;
+}
+
+static void gfx_probe_complete_display(VMAppleMachineState *vms,
+                                       uint64_t control)
+{
+    uint64_t stamp = ((uint64_t)vms->gfx_probe_fifo_page << 14) + 4 * 4;
+    uint8_t state[32], value[4];
+
+    if (!vms->gfx_probe_display_complete || vms->gfx_probe_display_saved ||
+        !vms->gfx_probe_display_state_valid || !vms->gfx_probe_fifo_page ||
+        !gfx_probe_save_ram(vms->gfx_probe_display_state,
+                           vms->gfx_probe_display_original, 32) ||
+        !gfx_probe_save_ram(stamp, vms->gfx_probe_display_stamp_original, 4) ||
+        !gfx_probe_save_ram(control + 4,
+                           vms->gfx_probe_display_consumer_original, 4)) {
+        return;
+    }
+    vms->gfx_probe_display_saved = true;
+    memcpy(state, vms->gfx_probe_display_original, sizeof(state));
+    /* Only acknowledge display zero; preserve every unimplemented field. */
+    stw_le_p(state + 18, 0);
+    if (!gfx_probe_write_verify(vms->gfx_probe_display_state, state, 32)) {
+        return;
+    }
+    if (vms->gfx_probe_display_mode) {
+        uint8_t modes[24];
+        uint64_t address = vms->gfx_probe_display_state + 512;
+
+        if (!gfx_probe_save_ram(address,
+                                vms->gfx_probe_display_mode_original,
+                                sizeof(modes))) {
+            return;
+        }
+        memcpy(modes, vms->gfx_probe_display_mode_original, sizeof(modes));
+        /* One timing entry: 1024x768 at 60 Hz, no connection flags. */
+        stw_le_p(modes + 8, 1);
+        stw_le_p(modes + 16, 1024);
+        stw_le_p(modes + 18, 768);
+        stl_le_p(modes + 20, 60U << 16);
+        if (!gfx_probe_write_verify(address, modes, sizeof(modes))) {
+            return;
+        }
+        trace_vmapple_gfx_display_mode();
+    }
+    stl_le_p(value, 20);
+    if (!gfx_probe_write_verify(control + 4, value, 4)) {
+        return;
+    }
+    stl_le_p(value, 256);
+    if (!gfx_probe_write_verify(stamp, value, 4)) {
+        return;
+    }
+    vms->gfx_probe_display_done = true;
+    vms->gfx_probe_stamp_pending |= 1 << 4;
+    if (vms->gfx_probe_root_wake) {
+        qemu_irq_pulse(qdev_get_gpio_in(vms->gic,
+                                       vms->irqmap[VMAPPLE_APV_GFX]));
+    }
+    trace_vmapple_gfx_display_complete();
+}
+
+/* Only the first timing revision acknowledgement, never an arbitrary command. */
+static void gfx_probe_ack_display_revision(VMAppleMachineState *vms,
+                                          uint64_t control, uint64_t address)
+{
+    uint32_t revision;
+    uint8_t payload[8], value[4];
+    uint64_t stamp = ((uint64_t)vms->gfx_probe_fifo_page << 14) + 16;
+
+    if (!vms->gfx_probe_display_event_sent ||
+        vms->gfx_probe_display_revision_saved ||
+        !gfx_probe_read_entry(NULL, vms->gfx_probe_display_state + 512,
+                              &revision) ||
+        !gfx_probe_save_ram(address + 12, payload, sizeof(payload)) ||
+        ldl_le_p(payload) != 0 || ldl_le_p(payload + 4) != revision ||
+        !gfx_probe_save_ram(control + 4,
+                            vms->gfx_probe_display_revision_original, 4) ||
+        ldl_le_p(vms->gfx_probe_display_revision_original) != 20 ||
+        !gfx_probe_save_ram(stamp,
+                            vms->gfx_probe_display_revision_original + 4, 4) ||
+        ldl_le_p(vms->gfx_probe_display_revision_original + 4) != 256) {
+        return;
+    }
+    vms->gfx_probe_display_revision_saved = true;
+    stl_le_p(value, 40);
+    if (!gfx_probe_write_verify(control + 4, value, 4)) {
+        return;
+    }
+    stl_le_p(value, 512);
+    if (!gfx_probe_write_verify(stamp, value, 4)) {
+        return;
+    }
+    vms->gfx_probe_stamp_pending |= 1 << 4;
+    if (vms->gfx_probe_root_wake) {
+        qemu_irq_pulse(qdev_get_gpio_in(vms->gic,
+                                       vms->irqmap[VMAPPLE_APV_GFX]));
+    }
+    trace_vmapple_gfx_display_revision(revision);
+}
+
+/* Bounded, no-wrap ordered metadata executor; no rendering or mapper access. */
+static void gfx_probe_process_lifecycle(VMAppleMachineState *vms, uint64_t control)
+{
+    VMAppleGfxProbeChannel *channel = &vms->gfx_probe_channels[1];
+    uint64_t stamp = ((uint64_t)vms->gfx_probe_fifo_page << 14) + 8;
+    uint32_t producer, consumer;
+
+    if (!vms->gfx_probe_task_lifecycle || vms->gfx_probe_task_prefix ||
+        vms->gfx_probe_lifecycle_poisoned || !vms->gfx_probe_fifo_page ||
+        !channel->registered || !gfx_probe_map_first_page(channel) ||
+        !gfx_probe_read_entry(NULL, control, &producer) ||
+        !gfx_probe_read_entry(NULL, control + 4, &consumer) ||
+        producer > 16384 || (producer & 3) ||
+        consumer != vms->gfx_probe_lifecycle_cursor || producer < consumer) {
+        return;
+    }
+    for (unsigned n = 0; n < 64 && producer > consumer; n++) {
+        uint8_t bytes[28], original[8], value[4];
+        VMAppleGfxProbeHeader header;
+        VMAppleGfxLifecycle candidate = vms->gfx_probe_lifecycle;
+        uint64_t address = channel->first_page_address + consumer;
+        uint32_t taskid;
+
+        if (producer - consumer < 12 || !gfx_probe_ram_span(address, 12) ||
+            address_space_read(&address_space_memory, address,
+                MEMTXATTRS_UNSPECIFIED, bytes, 12) != MEMTX_OK ||
+            !vmapple_gfx_probe_decode(bytes, 12, producer - consumer, &header) ||
+            header.length > sizeof(bytes) || header.length < 16 ||
+            header.tag != vms->gfx_probe_lifecycle_tag + 256 ||
+            vms->gfx_probe_lifecycle_tag > UINT32_MAX - 256 ||
+            !gfx_probe_ram_span(address, header.length) ||
+            address_space_read(&address_space_memory, address,
+                MEMTXATTRS_UNSPECIFIED, bytes, header.length) != MEMTX_OK ||
+            !vmapple_gfx_lifetime_apply(&candidate, &header, bytes + 12,
+                header.length - 12)) {
+            return;
+        }
+        taskid = ldl_le_p(bytes + 12);
+        if (header.opcode == 56) {
+            VMAppleGfxTaskLifetime *task =
+                vmapple_gfx_lifetime_find(&candidate, taskid >> 1);
+            if (!task || !gfx_probe_ram_span(task->root, 28)) {
+                return;
+            }
+        }
+        if (!gfx_probe_save_ram(control + 4, original, 4) ||
+            !gfx_probe_save_ram(stamp, original + 4, 4)) {
+            return;
+        }
+        stl_le_p(value, consumer + header.length);
+        if (!gfx_probe_write_verify(control + 4, value, 4)) {
+            vms->gfx_probe_lifecycle_poisoned = true;
+            return;
+        }
+        stl_le_p(value, header.tag);
+        if (!gfx_probe_write_verify(stamp, value, 4)) {
+            gfx_probe_write_verify(control + 4, original, 4);
+            gfx_probe_write_verify(stamp, original + 4, 4);
+            vms->gfx_probe_lifecycle_poisoned = true;
+            return;
+        }
+        vms->gfx_probe_lifecycle = candidate;
+        consumer += header.length;
+        vms->gfx_probe_lifecycle_cursor = consumer;
+        vms->gfx_probe_lifecycle_tag = header.tag;
+        vms->gfx_probe_stamp_pending |= 1 << 2;
+        trace_vmapple_gfx_lifecycle(header.opcode, consumer, header.tag);
+        if (vms->gfx_probe_root_wake) {
+            qemu_irq_pulse(qdev_get_gpio_in(vms->gic,
+                                           vms->irqmap[VMAPPLE_APV_GFX]));
+        }
+    }
+}
+
+/* Process only the first registered task+heap pair. Unknown/deletion commands
+ * remain pending; this cannot satisfy a dependency beyond tag 512. */
+static void gfx_probe_complete_task_prefix(VMAppleMachineState *vms,
+                                          uint64_t control)
+{
+    VMAppleGfxProbeChannel *channel = &vms->gfx_probe_channels[1];
+    VMAppleGfxProbeHeader task_header, heap_header;
+    VMAppleGfxProbeAddressSpace task;
+    VMAppleGfxProbeHeap heap;
+    uint8_t bytes[52], value[4];
+    uint64_t stamp = ((uint64_t)vms->gfx_probe_fifo_page << 14) + 8;
+    uint32_t consumer, producer;
+
+    if (!vms->gfx_probe_task_prefix || vms->gfx_probe_task_prefix_saved ||
+        !vms->gfx_probe_fifo_page || !channel->registered ||
+        !gfx_probe_read_entry(NULL, control, &producer) || producer < 52 ||
+        producer > 16384 || (producer & 3) ||
+        !gfx_probe_read_entry(NULL, control + 4, &consumer) || consumer ||
+        !gfx_probe_map_first_page(channel) ||
+        !gfx_probe_ram_span(channel->first_page_address, sizeof(bytes)) ||
+        address_space_read(&address_space_memory, channel->first_page_address,
+            MEMTXATTRS_UNSPECIFIED, bytes, sizeof(bytes)) != MEMTX_OK ||
+        !vmapple_gfx_probe_decode(bytes, 12, sizeof(bytes), &task_header) ||
+        !vmapple_gfx_probe_decode(bytes + 28, 12, 24, &heap_header) ||
+        task_header.tag != 256 || heap_header.tag != 512 ||
+        !vmapple_gfx_probe_address_space(&task_header, bytes + 12, 16, &task) ||
+        !vmapple_gfx_probe_heap(&heap_header, bytes + 40, 12, &heap) ||
+        task.id != heap.address_space_id ||
+        !gfx_probe_register_task_command(vms, &task_header,
+            channel->first_page_address) ||
+        !gfx_probe_register_task_command(vms, &heap_header,
+            channel->first_page_address + 28) ||
+        !gfx_probe_save_ram(control + 4, vms->gfx_probe_task_prefix_original, 4) ||
+        !gfx_probe_save_ram(stamp, vms->gfx_probe_task_prefix_original + 4, 4)) {
+        return;
+    }
+    vms->gfx_probe_task_prefix_saved = true;
+    stl_le_p(value, 52);
+    if (!gfx_probe_write_verify(control + 4, value, 4)) {
+        return;
+    }
+    stl_le_p(value, 512);
+    if (!gfx_probe_write_verify(stamp, value, 4)) {
+        return;
+    }
+    vms->gfx_probe_stamp_pending |= 1 << 2;
+    trace_vmapple_gfx_task_prefix(task.id);
+    if (vms->gfx_probe_root_wake) {
+        qemu_irq_pulse(qdev_get_gpio_in(vms->gic,
+                                       vms->irqmap[VMAPPLE_APV_GFX]));
+    }
+}
