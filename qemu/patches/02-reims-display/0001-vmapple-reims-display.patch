+/* At most 32 distinct cursor pairs per channel, first ring page only. */
+static void gfx_probe_doorbell(VMAppleMachineState *vms, uint32_t id)
+{
+    uint32_t control_offset;
+    uint8_t control[20], header[12];
+    uint64_t shared, address;
+    uint32_t producer, consumer;
+    VMAppleGfxProbeChannel *channel;
+
+    if (id == 0 || id > VMAPPLE_GFX_PROBE_CHANNELS ||
+        !vmapple_gfx_probe_channel(id, &control_offset)) {
+        return;
+    }
+    channel = &vms->gfx_probe_channels[id - 1];
+    shared = (uint64_t)vms->gfx_probe_shared_page << 14;
+    if (!shared || !gfx_probe_ram_span(shared + control_offset, 20) ||
+        address_space_read(&address_space_memory, shared + control_offset,
+            MEMTXATTRS_UNSPECIFIED, control, 20) != MEMTX_OK) {
+        return;
+    }
+    producer = ldl_le_p(control);
+    consumer = ldl_le_p(control + 4);
+    if (id == 2) {
+        gfx_probe_process_lifecycle(vms, shared + control_offset);
+        gfx_probe_complete_task_prefix(vms, shared + control_offset);
+    }
+    /* Submission gating is also independent of the trace-observer quota.
+     * Inspect only the exact first single-segment shape; never consume it. */
+    if (id == 1 && vms->gfx_probe_task_lifecycle &&
+        consumer == vms->gfx_probe_fill_cursor && producer >= consumer &&
+        producer - consumer >= 64 && producer <= 16384 && channel->registered &&
+        gfx_probe_map_first_page(channel)) {
+        uint8_t command[72];
+        VMAppleGfxProbeHeader submission_header;
+        uint32_t length = producer - consumer >= 72 ? 72 : 64;
+        uint64_t command_address = channel->first_page_address + consumer;
+        if (gfx_probe_ram_span(command_address, length) &&
+            address_space_read(&address_space_memory, command_address,
+                MEMTXATTRS_UNSPECIFIED, command, length) == MEMTX_OK &&
+            vmapple_gfx_probe_decode(command, 12, producer - consumer, &submission_header) &&
+            submission_header.opcode == 55 &&
+            vms->gfx_probe_fill_tag <= UINT32_MAX - 256 &&
+            submission_header.tag == vms->gfx_probe_fill_tag + 256) {
+            vms->gfx_probe_fill_control = shared + control_offset;
+            vms->gfx_probe_fill_command_length = submission_header.length;
+            if (submission_header.length == 72 &&
+                submission_header.metadata_count == 1 && length == 72) {
+                gfx_probe_submission_segment(vms, command + 12);
+            } else if (submission_header.length == 64 &&
+                       !submission_header.metadata_count) {
+                uint8_t normalized[60];
+                /* No encoded dependency: retain the current completed prefix
+                 * as a conservative local gate, not guest metadata. */
+                stl_le_p(normalized, 2);
+                stl_le_p(normalized + 4, vms->gfx_probe_lifecycle_tag);
+                memcpy(normalized + 8, command + 12, 52);
+                gfx_probe_submission_segment(vms, normalized);
+            }
+            vms->gfx_probe_fill_control = 0;
+        }
+    }
+    if (id == 1 && vms->gfx_probe_task_lifecycle && producer >= consumer &&
+        producer - consumer == 88 && producer <= 16384 &&
+        channel->registered && gfx_probe_map_first_page(channel)) {
+        uint8_t texture_command[88];
+        VMAppleGfxProbeHeader shape;
+        uint64_t texture_address = channel->first_page_address + consumer;
+        if (gfx_probe_ram_span(texture_address, sizeof(texture_command)) &&
+            address_space_read(&address_space_memory, texture_address,
+                MEMTXATTRS_UNSPECIFIED, texture_command,
+                sizeof(texture_command)) == MEMTX_OK &&
+            vmapple_gfx_probe_decode(texture_command, 12, 88, &shape) &&
+            shape.opcode == 55 && shape.length == 88 && !shape.metadata_count) {
+            for (unsigned pos = 0; pos < sizeof(texture_command); pos += 4) {
+                trace_vmapple_gfx_texture_submission(pos,
+                    ldl_le_p(texture_command + pos));
+            }
+        }
+    }
+    /* The trace budget must not cap the independent metadata executor. */
+    if (vms->gfx_probe_doorbells[id - 1] >= 32) {
+        return;
+    }
+    if (vms->gfx_probe_last_producer[id - 1] == producer &&
+        vms->gfx_probe_last_consumer[id - 1] == consumer) {
+        return;
+    }
+    vms->gfx_probe_last_producer[id - 1] = producer;
+    vms->gfx_probe_last_consumer[id - 1] = consumer;
+    vms->gfx_probe_doorbells[id - 1]++;
+    trace_vmapple_gfx_channel_probe(id, producer, consumer,
+        ldl_le_p(control + 8), ldl_le_p(control + 12), ldl_le_p(control + 16));
+    if (!channel->registered || ldl_le_p(control + 16) != channel->page ||
+        !gfx_probe_map_first_page(channel) || consumer > 16384 - 12 ||
+        producer > 16384 || producer < consumer ||
+        (producer & 3) || (consumer & 3) || producer - consumer < 12) {
+        return;
+    }
+    bool registration_prefix = true;
+
+    for (unsigned command = 0; command < 64 && producer - consumer >= 12;
+         command++) {
+        address = channel->first_page_address + consumer;
+        if (gfx_probe_ram_span(address, sizeof(header)) &&
+            address_space_read(&address_space_memory, address,
+                MEMTXATTRS_UNSPECIFIED, header, sizeof(header)) == MEMTX_OK) {
+            VMAppleGfxProbeHeader decoded;
+
+            trace_vmapple_gfx_channel_header(id, producer, consumer,
+                ldl_le_p(header), ldl_le_p(header + 4), ldl_le_p(header + 8));
+            if (vmapple_gfx_probe_decode(header, sizeof(header), producer - consumer,
+                                         &decoded) &&
+                decoded.length <= 16384 - consumer) {
+                uint32_t start = 12 + decoded.metadata_count * 8;
+                uint32_t end = MIN(decoded.length, start + 32);
+
+                if (id == 1 && decoded.opcode == 55 &&
+                    decoded.metadata_count == 1 && decoded.length == 72) {
+                    uint8_t submission[60];
+
+                    if (gfx_probe_ram_span(address + 12, sizeof(submission)) &&
+                        address_space_read(&address_space_memory, address + 12,
+                            MEMTXATTRS_UNSPECIFIED, submission,
+                            sizeof(submission)) == MEMTX_OK) {
+                        gfx_probe_submission_segment(vms, submission);
+                        for (unsigned pos = 0; pos < sizeof(submission); pos += 4) {
+                            trace_vmapple_gfx_submission_word(pos + 12,
+                                ldl_le_p(submission + pos));
+                        }
+                    }
+                }
+
+                if (id == 2 && registration_prefix &&
+                    (decoded.opcode == 56 || decoded.opcode == 51)) {
+                    bool valid = gfx_probe_register_task_command(vms, &decoded,
+                                                                 address);
+
+                    trace_vmapple_gfx_task_registration(decoded.opcode, valid);
+                    registration_prefix = valid;
+                } else if (id == 2) {
+                    registration_prefix = false;
+                }
+
+                if (id == 4 && decoded.opcode == 1 &&
+                    decoded.metadata_count == 0 && decoded.length == 20 &&
+                    decoded.tag == 256 && consumer == 0) {
+                    uint8_t payload[8];
+                    uint64_t state;
+                    bool registered = false;
+
+                    if (address_space_read(&address_space_memory, address + 12,
+                            MEMTXATTRS_UNSPECIFIED, payload, 8) == MEMTX_OK &&
+                        ldl_le_p(payload) == 0 &&
+                        vmapple_gfx_probe_page_address(ldl_le_p(payload + 4),
+                                                       &state) &&
+                        gfx_probe_ram_span(state, 16384) &&
+                        (!vms->gfx_probe_display_state_valid ||
+                         vms->gfx_probe_display_state == state)) {
+                        vms->gfx_probe_display_state = state;
+                        vms->gfx_probe_display_state_valid = true;
+                        registered = true;
+                    }
+                    trace_vmapple_gfx_display_state(registered);
+                    if (registered) {
+                        gfx_probe_complete_display(vms, shared + control_offset);
+                    }
+                }
+                if (id == 4 && consumer == 20 && decoded.opcode == 2 &&
+                    decoded.metadata_count == 0 && decoded.length == 20 &&
+                    decoded.tag == 512) {
+                    gfx_probe_ack_display_revision(vms, shared + control_offset,
+                                                    address);
+                }
+                for (uint32_t pos = start; pos < end; pos += 4) {
+                    uint32_t word;
+
+                    if (!gfx_probe_read_entry(NULL, address + pos, &word)) {
+                        break;
+                    }
+                    trace_vmapple_gfx_channel_payload(id, decoded.opcode,
+                                                     pos - start, word);
+                }
+                consumer += decoded.length;
+            } else {
+                break;
+            }
+        } else {
+            break;
+        }
+    }
 }
 
 static void gfx_stub_write(void *opaque, hwaddr offset, uint64_t value,
                            unsigned size)
 {
+    VMAppleMachineState *vms = opaque;
+
+#ifdef CONFIG_VMAPPLE_REIMS
+    if (vms->gfx_reims && !vms->reims_device) {
+        reims_init(vms);
+    }
+    if (vms->reims_device) {
+        gfx_probe(vms, 0, true, offset, size, value);
+        rvg_device_mmio_write(vms->reims_device, offset, value);
+        return;
+    }
+#endif
+    if (vms->gfx_probe_readback && offset == 0x1034 && size == 4) {
+        vms->gfx_probe_config = value;
+    }
+    if (vms->gfx_probe_readback && size == 4) {
+        switch (offset) {
+        case 0x101c:
+            vms->gfx_probe_shared_page = value;
+            vms->gfx_probe_display_state_valid = false;
+            vms->gfx_probe_display_state = 0;
+            memset(&vms->gfx_probe_root_prefix, 0,
+                   sizeof(vms->gfx_probe_root_prefix));
+            memset(vms->gfx_probe_heaps, 0, sizeof(vms->gfx_probe_heaps));
+            memset(vms->gfx_probe_address_space_valid, 0,
+                   sizeof(vms->gfx_probe_address_space_valid));
+            memset(vms->gfx_probe_address_spaces, 0,
+                   sizeof(vms->gfx_probe_address_spaces));
+            vms->gfx_probe_query_pending = false;
+            memset(&vms->gfx_probe_pending_query, 0,
+                   sizeof(vms->gfx_probe_pending_query));
+            memset(vms->gfx_probe_channels, 0,
+                   sizeof(vms->gfx_probe_channels));
+            break;
+        case 0x1030:
+            vms->gfx_probe_fifo_page = value;
+            vms->gfx_probe_cursor = 0;
+            break;
+        case 0x1004:
+            vms->gfx_probe_fifo_size = value;
+            break;
+        case 0x1020:
+            gfx_probe_doorbell(vms, value);
+            break;
+        case 0x1008:
+            gfx_probe_fifo(vms, value);
+            break;
+        }
+    }
+    gfx_probe(vms, 0, true, offset, size, value);
+}
