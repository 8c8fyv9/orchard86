+/* Opt-in diagnostic response transport only. Never signal unexecuted work. */
+static bool gfx_probe_write_empty_info(VMAppleMachineState *vms,
+                                       const VMAppleGfxProbeQuery *query)
+{
+    uint8_t response[16384], readback[16384];
+    MemoryRegionSection section;
+    bool writable;
+
+    if (!vms->gfx_probe_response_write || vms->gfx_probe_response_saved ||
+        query->response_size != sizeof(response)) {
+        return false;
+    }
+    section = memory_region_find(get_system_memory(), query->destination_page,
+                                 sizeof(response));
+    writable = section.mr && memory_region_is_ram(section.mr) &&
+               !memory_region_is_rom(section.mr) &&
+               !section.readonly &&
+               int128_get64(section.size) >= sizeof(response);
+    if (section.mr) {
+        memory_region_unref(section.mr);
+    }
+    if (!writable || !vmapple_gfx_probe_empty_info(response, sizeof(response)) ||
+        address_space_read(&address_space_memory, query->destination_page,
+                           MEMTXATTRS_UNSPECIFIED,
+                           vms->gfx_probe_response_original,
+                           sizeof(response)) != MEMTX_OK) {
+        return false;
+    }
+    vms->gfx_probe_response_address = query->destination_page;
+    /* Saved even on a partial write failure: retain originals for diagnosis. */
+    vms->gfx_probe_response_saved = true;
+    return address_space_write(&address_space_memory, query->destination_page,
+                               MEMTXATTRS_UNSPECIFIED, response,
+                               sizeof(response)) == MEMTX_OK &&
+           address_space_read(&address_space_memory, query->destination_page,
+                              MEMTXATTRS_UNSPECIFIED, readback,
+                              sizeof(readback)) == MEMTX_OK &&
+           memcmp(response, readback, sizeof(response)) == 0;
+}
