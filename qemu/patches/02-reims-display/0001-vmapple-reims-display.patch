+/* Resolve only the first page-list entry. No completion or memory writes. */
+static bool gfx_probe_map_first_page(VMAppleGfxProbeChannel *channel)
+{
+    uint64_t list_address, data_address;
+    uint8_t entry[4];
+
+    channel->first_page_valid = false;
+    channel->first_page_address = 0;
+    if (!channel->registered ||
+        !vmapple_gfx_probe_page_address(channel->page, &list_address) ||
+        !gfx_probe_ram_span(list_address, 16384) ||
+        address_space_read(&address_space_memory, list_address,
+                           MEMTXATTRS_UNSPECIFIED, entry, sizeof(entry)) !=
+                           MEMTX_OK ||
+        !vmapple_gfx_probe_page_address(ldl_le_p(entry), &data_address) ||
+        !gfx_probe_ram_span(data_address, 16384)) {
+        return false;
+    }
+    channel->first_page_address = data_address;
+    channel->first_page_valid = true;
+    return true;
+}
