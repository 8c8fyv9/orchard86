diff --git a/include/hw/vmapple/gfx-probe.h b/include/hw/vmapple/gfx-probe.h
new file mode 100644
index 00000000..61913eef
--- /dev/null
+++ b/include/hw/vmapple/gfx-probe.h
@@ -0,0 +1,705 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef HW_VMAPPLE_GFX_PROBE_H
+#define HW_VMAPPLE_GFX_PROBE_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <stddef.h>
+
+/* Diagnostic cursor only: never exposed as a guest completion counter.
+ * This first observer deliberately rejects wrap and counter rollover.
+ */
+static inline bool vmapple_gfx_probe_span(uint32_t capacity, uint32_t cursor,
+                                          uint32_t producer, uint32_t length)
+{
+    return capacity >= 12 && capacity <= 1024 * 1024 &&
+           cursor <= producer && producer <= capacity &&
+           !(cursor & 3) && !(producer & 3) && !(length & 3) &&
+           length >= 12 && length <= producer - cursor;
+}
+
+typedef struct VMAppleGfxProbeHeader {
+    uint16_t opcode;
+    uint16_t metadata_count;
+    uint32_t length;
+    uint32_t tag;
+} VMAppleGfxProbeHeader;
+
+static inline uint32_t vmapple_gfx_probe_le32(const uint8_t *p)
+{
+    return (uint32_t)p[0] | (uint32_t)p[1] << 8 |
+           (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+/* Supported submission payload includes one dependency and one segment. */
+static inline bool vmapple_gfx_probe_single_submission(const uint8_t *p,
+    size_t size, uint32_t completed, uint32_t guest_stamp)
+{
+    if (!p || size != 60 || !completed || guest_stamp != completed ||
+        vmapple_gfx_probe_le32(p) != 2 ||
+        !vmapple_gfx_probe_le32(p + 4) ||
+        (vmapple_gfx_probe_le32(p + 4) & 255) ||
+        vmapple_gfx_probe_le32(p + 4) > completed ||
+        !vmapple_gfx_probe_le32(p + 8) ||
+        vmapple_gfx_probe_le32(p + 12) != 1 ||
+        vmapple_gfx_probe_le32(p + 16) != 1 ||
+        vmapple_gfx_probe_le32(p + 20) != 1) {
+        return false;
+    }
+    for (unsigned offset = 24; offset < 44; offset += 4) {
+        if (vmapple_gfx_probe_le32(p + offset)) {
+            return false;
+        }
+    }
+    return (vmapple_gfx_probe_le32(p + 44) ||
+            vmapple_gfx_probe_le32(p + 48)) &&
+           vmapple_gfx_probe_le32(p + 52) == 40 &&
+           !vmapple_gfx_probe_le32(p + 56);
+}
+
+typedef struct VMAppleGfxProbeResourceDelete {
+    uint32_t task;
+    uint32_t resource;
+} VMAppleGfxProbeResourceDelete;
+
+/* Host resource deletion, not generic device object deletion or task release. */
+static inline bool vmapple_gfx_probe_resource_delete(
+    const VMAppleGfxProbeHeader *header, const uint8_t *payload, size_t size,
+    VMAppleGfxProbeResourceDelete *out)
+{
+    if (!header || !payload || !out || header->opcode != 37 ||
+        header->metadata_count || header->length != 20 || size != 8) {
+        return false;
+    }
+    out->task = vmapple_gfx_probe_le32(payload);
+    out->resource = vmapple_gfx_probe_le32(payload + 4);
+    return out->task && out->resource;
+}
+
+/* Keyed state: task ids are protocol values, never array indices. */
+#define VMAPPLE_GFX_LIFECYCLE_TASKS 32
+#define VMAPPLE_GFX_LIFECYCLE_DELETIONS 64
+typedef struct VMAppleGfxTaskLifetime {
+    uint32_t id, generation;
+    uint64_t root, heap, extent;
+    uint32_t heap_size;
+    bool live, mapper;
+} VMAppleGfxTaskLifetime;
+typedef struct VMAppleGfxLifecycle {
+    VMAppleGfxTaskLifetime tasks[VMAPPLE_GFX_LIFECYCLE_TASKS];
+    VMAppleGfxProbeResourceDelete deleted[VMAPPLE_GFX_LIFECYCLE_DELETIONS];
+    unsigned deleted_count;
+} VMAppleGfxLifecycle;
+
+static inline VMAppleGfxTaskLifetime *vmapple_gfx_lifetime_find(
+    VMAppleGfxLifecycle *state, uint32_t id)
+{
+    if (!state || !id) {
+        return NULL;
+    }
+    for (unsigned i = 0; i < VMAPPLE_GFX_LIFECYCLE_TASKS; i++) {
+        if (state->tasks[i].id == id) {
+            return &state->tasks[i];
+        }
+    }
+    return NULL;
+}
+
+/* Pure state transition only; callers validate RAM and persist completion. */
+static inline bool vmapple_gfx_lifetime_apply(VMAppleGfxLifecycle *state,
+    const VMAppleGfxProbeHeader *h, const uint8_t *p, size_t size)
+{
+    VMAppleGfxTaskLifetime *task;
+    uint32_t id;
+    if (!state || !h || !p || h->metadata_count || size < 4 ||
+        h->length != size + 12) {
+        return false;
+    }
+    id = vmapple_gfx_probe_le32(p);
+    if (h->opcode == 56) {
+        uint64_t root, extent;
+        if (size != 16 || !(id >> 1)) {
+            return false;
+        }
+        id >>= 1;
+        root = (uint64_t)vmapple_gfx_probe_le32(p + 12) << 14;
+        extent = vmapple_gfx_probe_le32(p + 4) |
+                 (uint64_t)vmapple_gfx_probe_le32(p + 8) << 32;
+        if (!root || !extent) {
+            return false;
+        }
+        task = vmapple_gfx_lifetime_find(state, id);
+        if (!task) {
+            for (unsigned i = 0; i < VMAPPLE_GFX_LIFECYCLE_TASKS; i++) {
+                if (!state->tasks[i].id) {
+                    task = &state->tasks[i];
+                    break;
+                }
+            }
+        }
+        if (!task || task->live || task->generation == UINT32_MAX) {
+            return false;
+        }
+        *task = (VMAppleGfxTaskLifetime){.id = id,
+            .generation = task->generation + 1, .root = root, .extent = extent,
+            .live = true, .mapper = (vmapple_gfx_probe_le32(p) & 1) != 0};
+        return true;
+    }
+    task = vmapple_gfx_lifetime_find(state, id);
+    if (!task || !task->live) {
+        return false;
+    }
+    if (h->opcode == 51 && size == 12) {
+        uint64_t heap = (uint64_t)vmapple_gfx_probe_le32(p + 4) << 14;
+        uint32_t length = vmapple_gfx_probe_le32(p + 8);
+        if (!heap || !length || length > 16 * 1024 * 1024 || task->heap) {
+            return false;
+        }
+        task->heap = heap;
+        task->heap_size = length;
+        return true;
+    }
+    if (h->opcode == 37 && size == 8) {
+        VMAppleGfxProbeResourceDelete deletion;
+        if (!vmapple_gfx_probe_resource_delete(h, p, size, &deletion) ||
+            state->deleted_count == VMAPPLE_GFX_LIFECYCLE_DELETIONS) {
+            return false;
+        }
+        for (unsigned i = 0; i < state->deleted_count; i++) {
+            if (state->deleted[i].task == id &&
+                state->deleted[i].resource == deletion.resource) {
+                return false;
+            }
+        }
+        state->deleted[state->deleted_count++] = deletion;
+        return true;
+    }
+    if (h->opcode == 32 && size == 4) {
+        for (unsigned i = 0; i < state->deleted_count;) {
+            if (state->deleted[i].task == id) {
+                state->deleted[i] = state->deleted[--state->deleted_count];
+            } else {
+                i++;
+            }
+        }
+        task->live = false;
+        task->root = task->heap = task->extent = task->heap_size = 0;
+        task->mapper = false;
+        return true;
+    }
+    return false;
+}
+
+typedef struct VMAppleGfxProbeFill {
+    uint32_t resource;
+    uint64_t offset;
+    uint64_t length;
+    uint8_t value;
+} VMAppleGfxProbeFill;
+
+/* Minimal software execution candidate, not permission to access guest memory. */
+static inline bool vmapple_gfx_probe_fill(const uint8_t *bytes, size_t size,
+    uint64_t extent, VMAppleGfxProbeFill *out)
+{
+    VMAppleGfxProbeFill fill;
+    uint32_t value;
+
+    if (!bytes || !out || size != 40 ||
+        vmapple_gfx_probe_le32(bytes) != 40 ||
+        vmapple_gfx_probe_le32(bytes + 4) != 2 ||
+        vmapple_gfx_probe_le32(bytes + 8) != 0x132 ||
+        vmapple_gfx_probe_le32(bytes + 12) != 32) {
+        return false;
+    }
+    fill.resource = vmapple_gfx_probe_le32(bytes + 16);
+    fill.offset = vmapple_gfx_probe_le32(bytes + 20) |
+                  (uint64_t)vmapple_gfx_probe_le32(bytes + 24) << 32;
+    fill.length = vmapple_gfx_probe_le32(bytes + 28) |
+                  (uint64_t)vmapple_gfx_probe_le32(bytes + 32) << 32;
+    value = vmapple_gfx_probe_le32(bytes + 36);
+    if (!fill.resource || !fill.length || fill.length > 4096 || value > 255 ||
+        fill.offset > extent || fill.length > extent - fill.offset) {
+        return false;
+    }
+    fill.value = value;
+    *out = fill;
+    return true;
+}
+
+/* Decode only the fixed header. Unknown opcode/tag semantics remain opaque.
+ * On failure leave the caller's output unchanged.
+ */
+static inline bool vmapple_gfx_probe_decode(const uint8_t *bytes, size_t size,
+                                           uint32_t available,
+                                           VMAppleGfxProbeHeader *out)
+{
+    VMAppleGfxProbeHeader h;
+
+    if (!bytes || !out || size < 12) {
+        return false;
+    }
+    h.opcode = (uint16_t)bytes[0] | (uint16_t)bytes[1] << 8;
+    h.metadata_count = (uint16_t)bytes[2] | (uint16_t)bytes[3] << 8;
+    h.length = vmapple_gfx_probe_le32(bytes + 4);
+    h.tag = vmapple_gfx_probe_le32(bytes + 8);
+    if (h.length < 12 || (h.length & 3) || h.length > available ||
+        (uint32_t)h.metadata_count * 8 > h.length - 12) {
+        return false;
+    }
+    *out = h;
+    return true;
+}
+
+/* Payload begins after the variable metadata array. No guest pointer decoding. */
+static inline bool vmapple_gfx_probe_payload(const VMAppleGfxProbeHeader *h,
+                                            uint32_t offset, uint32_t size,
+                                            uint32_t *position)
+{
+    uint32_t start;
+
+    if (!h || !position || h->length < 12 ||
+        (uint32_t)h->metadata_count * 8 > h->length - 12) {
+        return false;
+    }
+    start = 12 + (uint32_t)h->metadata_count * 8;
+    if (offset > h->length - start || size > h->length - start - offset) {
+        return false;
+    }
+    *position = start + offset;
+    return true;
+}
+
+/* Shared control table: bounded to one 16 KiB allocation. */
+static inline bool vmapple_gfx_probe_channel(uint32_t id, uint32_t *offset)
+{
+    if (!offset || id == 0 || id > (16384 - 1024) / 20) {
+        return false;
+    }
+    *offset = 1024 + (id - 1) * 20;
+    return true;
+}
+
+/* Diagnostic host registry, not a promise that commands can execute. */
+#define VMAPPLE_GFX_PROBE_CHANNELS 8
+
+typedef struct VMAppleGfxProbeChannel {
+    bool registered;
+    bool first_page_valid;
+    uint64_t first_page_address;
+    uint32_t id;
+    uint32_t page;
+    uint16_t ring_units;
+} VMAppleGfxProbeChannel;
+
+static inline bool vmapple_gfx_probe_register(VMAppleGfxProbeChannel *slots,
+                                              uint32_t id,
+                                              const uint8_t *control,
+                                              size_t size)
+{
+    uint32_t page, packed;
+    VMAppleGfxProbeChannel *slot;
+
+    if (!slots || !control || size != 20 || id == 0 ||
+        id > VMAPPLE_GFX_PROBE_CHANNELS) {
+        return false;
+    }
+    page = vmapple_gfx_probe_le32(control + 16);
+    packed = vmapple_gfx_probe_le32(control + 12);
+    /* Only the fresh, idle registration contract is implemented. */
+    if (!page || vmapple_gfx_probe_le32(control) != 0 ||
+        vmapple_gfx_probe_le32(control + 4) != 0 ||
+        vmapple_gfx_probe_le32(control + 8) != UINT32_MAX ||
+        (packed & 0xffff) != id) {
+        return false;
+    }
+    slot = &slots[id - 1];
+    if (slot->registered) {
+        return slot->id == id && slot->page == page &&
+               slot->ring_units == (packed >> 16);
+    }
+    slot->id = id;
+    slot->page = page;
+    slot->ring_units = packed >> 16;
+    slot->registered = true;
+    return true;
+}
+
+static inline bool vmapple_gfx_probe_page_address(uint32_t page,
+                                                 uint64_t *address)
+{
+    if (!page || !address) {
+        return false;
+    }
+    *address = (uint64_t)page << 14;
+    return true;
+}
+
+typedef struct VMAppleGfxProbeQuery {
+    uint64_t response_size;
+    uint64_t destination_page;
+} VMAppleGfxProbeQuery;
+
+/* Decode the fixed device-info query variant only; caller validates RAM. */
+static inline bool vmapple_gfx_probe_query(const VMAppleGfxProbeHeader *h,
+                                          const uint8_t *payload, size_t size,
+                                          VMAppleGfxProbeQuery *out)
+{
+    VMAppleGfxProbeQuery q;
+    uint32_t position;
+
+    if (!h || !payload || !out || size != 12 || h->opcode != 58 ||
+        h->metadata_count || h->length != 24 ||
+        !vmapple_gfx_probe_payload(h, 0, 12, &position) ||
+        vmapple_gfx_probe_le32(payload) != 18) {
+        return false;
+    }
+    q.response_size = (uint64_t)vmapple_gfx_probe_le32(payload + 4) << 3;
+    if (q.response_size != 16384 ||
+        !vmapple_gfx_probe_page_address(
+            vmapple_gfx_probe_le32(payload + 8), &q.destination_page)) {
+        return false;
+    }
+    *out = q;
+    return true;
+}
+
+/* A completion value carries its stamp index in the low byte. The remaining
+ * bits are a sequence, not a byte address. Count comes from negotiated state.
+ */
+static inline bool vmapple_gfx_probe_stamp(uint64_t base, uint32_t count,
+                                          uint32_t value, uint64_t *address)
+{
+    uint32_t index = value & 255;
+    uint64_t offset = (uint64_t)index * 4;
+
+    if (!address || !base || (base & 3) || !count || count > 256 ||
+        index >= count || base > UINT64_MAX - offset - 4) {
+        return false;
+    }
+    *address = base + offset;
+    return true;
+}
+
+/* The guest bounds parsing by allocation_size / 8, not a returned count.
+ * Key 18 terminates this version's 0..17 device-info key space. This response
+ * deliberately advertises no capabilities and does not imply GPU support.
+ */
+static inline bool vmapple_gfx_probe_empty_info(uint8_t *buffer, size_t size)
+{
+    size_t offset;
+
+    if (!buffer || size != 16384) {
+        return false;
+    }
+    for (offset = 0; offset < size; offset += 8) {
+        buffer[offset] = 18;
+        buffer[offset + 1] = 0;
+        buffer[offset + 2] = 0;
+        buffer[offset + 3] = 0;
+        buffer[offset + 4] = 0;
+        buffer[offset + 5] = 0;
+        buffer[offset + 6] = 0;
+        buffer[offset + 7] = 0;
+    }
+    return true;
+}
+
+/* Channel stamps occupy one 32-bit slot each in the reserved FIFO page. */
+static inline bool vmapple_gfx_probe_channel_stamp(uint64_t fifo, uint32_t channel,
+                                                 uint64_t *address)
+{
+    if (!address || !fifo || (fifo & 16383) || channel >= 8 ||
+        fifo > UINT64_MAX - channel * 4 - 4) {
+        return false;
+    }
+    *address = fifo + channel * 4;
+    return true;
+}
+
+/* Root channel index is fixed at zero. Its stamp storage is the FIFO's
+ * reserved first 16 KiB page, not the shared control-table allocation.
+ * Reject tags belonging to another channel instead of inferring a new slot.
+ */
+static inline bool vmapple_gfx_probe_root_stamp(uint32_t fifo_page,
+                                               uint32_t sequence,
+                                               uint64_t *address)
+{
+    uint64_t base;
+
+    if ((sequence & 255) ||
+        !vmapple_gfx_probe_page_address(fifo_page, &base)) {
+        return false;
+    }
+    return vmapple_gfx_probe_stamp(base, 1, sequence, address);
+}
+
+typedef struct VMAppleGfxProbeAddressSpace {
+    uint32_t id;
+    bool flag;
+    uint64_t extent;
+    uint64_t root_address;
+} VMAppleGfxProbeAddressSpace;
+
+/* Kernel registration sets flag; mapper-backed addresses must not be treated
+ * as ordinary table translations or identity-mapped physical RAM.
+ */
+static inline bool vmapple_gfx_probe_uses_table(
+    const VMAppleGfxProbeAddressSpace *space)
+{
+    return space && !space->flag;
+}
+
+/* Descriptor only: validating a root does not implement page-table walking. */
+static inline bool vmapple_gfx_probe_address_space(
+    const VMAppleGfxProbeHeader *h, const uint8_t *payload, size_t size,
+    VMAppleGfxProbeAddressSpace *out)
+{
+    VMAppleGfxProbeAddressSpace space;
+    uint32_t packed;
+
+    if (!h || !payload || !out || h->opcode != 56 || h->metadata_count ||
+        h->length != 28 || size != 16) {
+        return false;
+    }
+    packed = vmapple_gfx_probe_le32(payload);
+    space.id = packed >> 1;
+    space.flag = packed & 1;
+    space.extent = vmapple_gfx_probe_le32(payload + 4) |
+                   (uint64_t)vmapple_gfx_probe_le32(payload + 8) << 32;
+    if (space.id >= 8 || !space.extent ||
+        !vmapple_gfx_probe_page_address(
+            vmapple_gfx_probe_le32(payload + 12), &space.root_address)) {
+        return false;
+    }
+    *out = space;
+    return true;
+}
+
+typedef struct VMAppleGfxProbeHeap {
+    bool registered;
+    uint32_t address_space_id;
+    uint64_t gpu_address;
+    uint32_t size;
+} VMAppleGfxProbeHeap;
+
+/* The address is GPU virtual, not a physical RAM page. Translation is separate. */
+static inline bool vmapple_gfx_probe_heap(
+    const VMAppleGfxProbeHeader *h, const uint8_t *payload, size_t size,
+    VMAppleGfxProbeHeap *out)
+{
+    VMAppleGfxProbeHeap heap = {0};
+    uint32_t page;
+
+    if (!h || !payload || !out || h->opcode != 51 || h->metadata_count ||
+        h->length != 24 || size != 12) {
+        return false;
+    }
+    heap.address_space_id = vmapple_gfx_probe_le32(payload);
+    page = vmapple_gfx_probe_le32(payload + 4);
+    heap.size = vmapple_gfx_probe_le32(payload + 8);
+    if (heap.address_space_id >= 8 || !page || !heap.size ||
+        heap.size > 16 * 1024 * 1024) {
+        return false;
+    }
+    heap.gpu_address = (uint64_t)page << 14;
+    *out = heap;
+    return true;
+}
+
+static inline bool vmapple_gfx_probe_heap_register(
+    VMAppleGfxProbeHeap *slots, const bool *address_spaces,
+    const VMAppleGfxProbeHeap *heap)
+{
+    VMAppleGfxProbeHeap *old;
+
+    if (!slots || !address_spaces || !heap || heap->address_space_id >= 8 ||
+        !address_spaces[heap->address_space_id] || !heap->gpu_address ||
+        (heap->gpu_address & 16383) || !heap->size ||
+        heap->size > 16 * 1024 * 1024) {
+        return false;
+    }
+    old = &slots[heap->address_space_id];
+    if (old->registered) {
+        return old->gpu_address == heap->gpu_address && old->size == heap->size;
+    }
+    *old = *heap;
+    old->registered = true;
+    return true;
+}
+
+/* Two 4096-entry levels, 32-bit page entries and 16 KiB pages. The callback
+ * must reject non-RAM reads; the walker never writes or caches translations.
+ */
+typedef bool (*VMAppleGfxProbeReadEntry)(void *opaque, uint64_t address,
+                                        uint32_t *entry);
+
+typedef struct VMAppleGfxProbeWalkResult {
+    unsigned stage; /* 1=input, 2=interior read, 3=interior absent/invalid,
+                     * 4=leaf read, 5=leaf absent. Zero means translated. */
+    uint32_t entry;
+} VMAppleGfxProbeWalkResult;
+
+static inline bool vmapple_gfx_probe_translate_detail(
+    uint64_t root, uint64_t gpu_address, VMAppleGfxProbeReadEntry read_entry,
+    void *opaque, uint64_t *physical, VMAppleGfxProbeWalkResult *detail)
+{
+    uint32_t interior, leaf;
+    uint64_t table, result;
+
+    if (!detail) {
+        return false;
+    }
+    *detail = (VMAppleGfxProbeWalkResult){.stage = 1};
+    if (!root || (root & 16383) || root > UINT64_MAX - 16384 ||
+        gpu_address >= (UINT64_C(1) << 38) || !read_entry || !physical) {
+        return false;
+    }
+    detail->stage = 2;
+    if (!read_entry(opaque, root + ((gpu_address >> 26) & 4095) * 4, &interior)) {
+        return false;
+    }
+    detail->stage = 3;
+    detail->entry = interior;
+    table = (uint64_t)interior << 14;
+    if (!interior || (interior & 0x80000000) || table == root) {
+        return false;
+    }
+    detail->stage = 4;
+    detail->entry = 0;
+    if (!read_entry(opaque, table + ((gpu_address >> 14) & 4095) * 4, &leaf)) {
+        return false;
+    }
+    detail->stage = 5;
+    detail->entry = leaf;
+    if (!(leaf & 0x7fffffff)) {
+        return false;
+    }
+    /* Bit31 is a leaf attribute, not part of the physical page number. */
+    result = ((uint64_t)(leaf & 0x7fffffff) << 14) | (gpu_address & 16383);
+    *physical = result;
+    detail->stage = 0;
+    return true;
+}
+
+static inline bool vmapple_gfx_probe_translate(
+    uint64_t root, uint64_t gpu_address, VMAppleGfxProbeReadEntry read_entry,
+    void *opaque, uint64_t *physical)
+{
+    VMAppleGfxProbeWalkResult detail;
+
+    return vmapple_gfx_probe_translate_detail(root, gpu_address, read_entry,
+                                             opaque, physical, &detail);
+}
+/* Address-space root names a descriptor, not a raw table. */
+static inline bool vmapple_gfx_probe_table_descriptor(
+    const uint8_t *bytes, size_t size, uint64_t *table)
+{
+    uint64_t address;
+    if (!bytes || !table || size != 28 ||
+        vmapple_gfx_probe_le32(bytes + 4) != 2 ||
+        !vmapple_gfx_probe_page_address(vmapple_gfx_probe_le32(bytes), &address)) {
+        return false;
+    }
+    *table = address;
+    return true;
+}
+/* IOSurface counters count 16-byte records. Limit is observer budget. */
+static inline bool vmapple_gfx_probe_iosfc_slot(
+    uint64_t base, uint64_t capacity, uint64_t consumer, uint64_t producer,
+    uint64_t *address)
+{
+    if (!address || !base || (base & 16383) || !capacity || capacity > 1024 ||
+        producer <= consumer || producer - consumer > capacity ||
+        base > UINT64_MAX - capacity * 16) {
+        return false;
+    }
+    *address = base + (consumer % capacity) * 16;
+    return true;
+}
+typedef struct VMAppleGfxProbeSurface {
+    uint32_t pixel_format, base_offset, allocation_size;
+    uint32_t width, height, bytes_per_row;
+    uint16_t bytes_per_element;
+} VMAppleGfxProbeSurface;
+
+/* Deliberately only accept packed linear surfaces. This is metadata validation,
+ * not permission to access any backing memory or proof of a renderable format.
+ */
+static inline bool vmapple_gfx_probe_surface(const uint8_t *bytes, size_t size,
+                                            VMAppleGfxProbeSurface *surface)
+{
+    VMAppleGfxProbeSurface result;
+    uint64_t row, end;
+
+    if (!bytes || !surface || size != 512 || bytes[36] != 0) {
+        return false;
+    }
+    result.pixel_format = vmapple_gfx_probe_le32(bytes + 4);
+    result.base_offset = vmapple_gfx_probe_le32(bytes + 8);
+    result.allocation_size = vmapple_gfx_probe_le32(bytes + 16);
+    result.width = vmapple_gfx_probe_le32(bytes + 20) >> 8;
+    result.height = vmapple_gfx_probe_le32(bytes + 24) >> 8;
+    result.bytes_per_row = vmapple_gfx_probe_le32(bytes + 28);
+    result.bytes_per_element = bytes[32] | (uint16_t)bytes[33] << 8;
+    row = (uint64_t)result.width * result.bytes_per_element;
+    end = (uint64_t)result.base_offset +
+          (uint64_t)result.bytes_per_row * result.height;
+    if (!result.width || !result.height || !result.bytes_per_element ||
+        row > result.bytes_per_row || end > result.allocation_size) {
+        return false;
+    }
+    *surface = result;
+    return true;
+}
+/* Backing entries encode page number in bits31:2.
+ * Root tag1 names a list; tag3 selects a directory of lists. Data
+ * entries within a list have tag1. Support only one-list allocations.
+ */
+static inline bool vmapple_gfx_probe_backing(
+    uint32_t root, uint64_t allocation_size, uint64_t byte_offset,
+    VMAppleGfxProbeReadEntry read_entry, void *opaque, uint64_t *physical)
+{
+    uint64_t list = (uint64_t)(root >> 2) << 14;
+    uint32_t entry;
+
+    if (!physical || !read_entry || !list || (root & 3) != 1 ||
+        !allocation_size || allocation_size > UINT64_C(16384) * 4096 ||
+        byte_offset >= allocation_size ||
+        !read_entry(opaque, list + (byte_offset >> 14) * 4, &entry) ||
+        (entry & 3) != 1 || !(entry >> 2)) {
+        return false;
+    }
+    *physical = ((uint64_t)(entry >> 2) << 14) + (byte_offset & 16383);
+    return true;
+}
+typedef struct VMAppleGfxProbeRootPrefix {
+    unsigned count;
+    uint32_t bytes;
+    bool failed;
+} VMAppleGfxProbeRootPrefix;
+
+/* Only these seven ordered, actually handled registration/query commands may
+ * form the initial completion candidate. This never publishes completion.
+ */
+static inline bool vmapple_gfx_probe_root_prefix(
+    VMAppleGfxProbeRootPrefix *prefix, const VMAppleGfxProbeHeader *header,
+    bool handled)
+{
+    static const uint16_t opcodes[7] = {56, 51, 48, 48, 48, 48, 58};
+    static const uint32_t lengths[7] = {28, 24, 16, 16, 16, 16, 24};
+    unsigned n;
+
+    if (!prefix || !header || prefix->failed || prefix->count >= 7) {
+        return false;
+    }
+    n = prefix->count;
+    if (!handled || header->metadata_count || header->opcode != opcodes[n] ||
+        header->length != lengths[n] || header->tag != (n + 1) * 256) {
+        prefix->failed = true;
+        return false;
+    }
+    prefix->bytes += header->length;
+    prefix->count++;
+    return prefix->count == 7 && prefix->bytes == 140;
+}
+#endif
