+#include "reims-display-mode.h"
+
+static void reims_init(VMAppleMachineState *vms)
+{
+    MachineState *machine = MACHINE(vms);
+    VmappleRamSpan deny[9], spans[10];
+    RvgMemoryRange ranges[10];
+    RvgMemoryRangeFile files[10];
+    uint64_t base = vms->memmap[VMAPPLE_MEM].base;
+    size_t denied = 0, count;
+    int fd = memory_region_get_fd(machine->ram);
+    if (vms->diagnostic_ro_size) {
+        deny[denied++] = (VmappleRamSpan){vms->diagnostic_ro_start,
+                                       vms->diagnostic_ro_size};
+    }
+    for (unsigned i = 0; i < 8; i++) {
+        uint64_t *r = vms->diagnostic_bank_regs[i];
+        if (r[2] == 7) {
+            uint64_t end = r[1] + (vms->diagnostic_bank_page_upper ? 0x4000 : 1);
+            deny[denied++] = (VmappleRamSpan){r[0], end - r[0]};
+        }
+    }
+    count = vmapple_ram_complement(base, machine->ram_size, deny, denied,
+                                   spans, ARRAY_SIZE(spans));
+    if (count == SIZE_MAX || count == 0) {
+        error_report("Reims protected RAM complement invalid or empty");
+        exit(EXIT_FAILURE);
+    }
+    for (size_t i = 0; i < count; i++) {
+        uint64_t offset = spans[i].start - base;
+        void *host = (uint8_t *)memory_region_get_ram_ptr(machine->ram) + offset;
+        if (vms->recovery_protection) {
+            /* The isolated service requires whole 16 KiB host pages. QEMU's
+             * memfd RAM may be only host-page aligned. Reserve then map ONLY
+             * this writable span; no alias of an excluded page is constructed.
+             * These views live until process exit, like the frozen device. */
+            size_t reserve_size = spans[i].length + 0x4000;
+            void *reservation = mmap(NULL, reserve_size, PROT_NONE,
+                                     MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+            if (reservation == MAP_FAILED) {
+                error_report("Reims aligned span reservation: %s", strerror(errno));
+                exit(EXIT_FAILURE);
+            }
+            uintptr_t aligned = ((uintptr_t)reservation + 0x3fff) & ~(uintptr_t)0x3fff;
+            size_t prefix = aligned - (uintptr_t)reservation;
+            size_t suffix = reserve_size - prefix - spans[i].length;
+            if (prefix) { munmap(reservation, prefix); }
+            if (suffix) { munmap((void *)(aligned + spans[i].length), suffix); }
+            host = mmap((void *)aligned, spans[i].length, PROT_READ | PROT_WRITE,
+                        MAP_SHARED | MAP_FIXED, fd,
+                        qemu_ram_get_fd_offset(machine->ram->ram_block) + offset);
+            if (host == MAP_FAILED) {
+                error_report("Reims aligned span mapping: %s", strerror(errno));
+                exit(EXIT_FAILURE);
+            }
+        }
+        ranges[i] = (RvgMemoryRange){
+            .physical_address = spans[i].start, .physical_length = spans[i].length,
+            .host_address = host,
+        };
+        files[i] = (RvgMemoryRangeFile){.fd = fd,
+            .offset = qemu_ram_get_fd_offset(machine->ram->ram_block) + offset};
+    }
+    RvgMemoryMap map = {.ranges = ranges, .range_count = count};
+    vms->reims_map_frozen = true;
+    info_report("Reims RAM map: %zu writable spans, %zu protected exclusions", count, denied);
+    RvgIOSurfaceCallbacks icb = {
+        .struct_size = sizeof(icb), .ctx = vms,
+        .raise_interrupt = reims_surface_irq, .destroy = reims_surface_destroy,
+    };
+    RvgIOSurfaceDeviceConfig isc = {
+        .struct_size = sizeof(isc), .memory_map = &map, .callbacks = &icb,
+    };
+    RvgHostCallbacks cb = {
+        .struct_size = sizeof(cb), .ctx = vms, .raise_interrupt = reims_gpu_irq,
+        .destroy = reims_device_destroy,
+    };
+    RvgDeviceConfig config = {
+        .struct_size = sizeof(config), .display_port_count = vms->reims_display_count,
+        .memory_map = &map, .memory_files = files, .callbacks = &cb,
+        .use_iosurface_mapper = true,
+        /* Modern guests request task address spaces beyond the local limit. */
+        .process_isolation = vms->recovery_protection,
+    };
+    RvgDisplayCallbacks dcb = {
+        .struct_size = sizeof(dcb), .ctx = NULL,
+        .mode_change = reims_mode, .new_frame = reims_frame,
+        .cursor_glyph = reims_cursor_glyph, .cursor_show = reims_cursor_show,
+        .cursor_move = reims_cursor_move,
+        .destroy = reims_display_destroy,
+    };
+    RvgDisplayConfig display = {
+        /* Keep the old ABI size unless identity is explicitly requested. */
+        .struct_size = 64, .serial_number = 1,
+        .width_millimeters = 300, .height_millimeters = 220, .callbacks = &dcb,
+    };
+    RvgDisplayMode mode;
+
+    if (vms->reims_display_count < 1 ||
+        vms->reims_display_count > RVG_MAX_DISPLAY_PORTS) {
+        error_report("Reims display count requires 1..%u", RVG_MAX_DISPLAY_PORTS);
+        exit(EXIT_FAILURE);
+    }
+    if (!vmapple_reims_mode_valid(vms->reims_mode_width,
+                                  vms->reims_mode_height,
+                                  vms->reims_mode_refresh_hz)) {
+        error_report("Reims mode requires width/height 1..4096 and refresh 1..UINT32_MAX Hz");
+        exit(EXIT_FAILURE);
+    }
+    mode = (RvgDisplayMode){
+        .width = vms->reims_mode_width,
+        .height = vms->reims_mode_height,
+        .refresh_rate_hz = vms->reims_mode_refresh_hz,
+    };
+    if (fd < 0) {
+        error_report("Reims requires shared memfd RAM (memory-backend-memfd,share=on)");
+        exit(EXIT_FAILURE);
+    }
+    vms->reims_active_screens = vms->reims_display_count;
+    rvg_log_set_handler(reims_log, NULL,
+                        g_strcmp0(g_getenv("QEMU_REIMS_TRACE_PRESENT"), "1") == 0
+                        ? RVG_LOG_TRACE : RVG_LOG_WARN);
+    qemu_event_init(&vms->reims_device_done, false);
+    qemu_event_init(&vms->reims_surface_done, false);
+    vms->reims_bh = qemu_bh_new(reims_irq_bh, vms);
+    reims_require(rvg_iosurface_device_create(&isc, &vms->reims_surface), "IOSurface");
+    reims_require(rvg_device_create(&config, &vms->reims_device), "device");
+    for (unsigned i = 0; i < vms->reims_active_screens; i++) {
+        VMAppleReimsScreen *screen = &vms->reims_screens[i];
+        if (!screen->reims_console) {
+            reims_console_create_one(vms, i);
+        }
+        dcb.ctx = screen;
+        display.serial_number = i + 1;
+        display.port = i;
+        struct {
+            RvgDisplayConfig config;
+            uint8_t uuid[16];
+        } identity = { .config = display };
+        _Static_assert(sizeof(RvgDisplayConfig) == 64, "pinned display ABI");
+        if (reims_display_identity(vms->reims_display_identity_seed, i,
+                                   identity.uuid)) {
+            identity.config.struct_size = sizeof(identity);
+        }
+        reims_require(rvg_display_create(vms->reims_device, &identity.config,
+                                        &screen->reims_display), "display");
+        rvg_display_set_modes(screen->reims_display, &mode, 1);
+    }
+    vms->reims_exit.notify = reims_exit;
+    /* libc exit runs after main-thread TLS destructors on Linux. */
+    qemu_add_cleanup_notifier(&vms->reims_exit);
+    info_report("Reims backend initialized with serialized frame readback");
+}
+#endif
