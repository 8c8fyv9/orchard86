+/* Only the first 16 KiB descriptor page is supported initially. */
+static bool iosfc_probe_map(VMAppleMachineState *vms, uint32_t id)
+{
+    uint32_t directory_entry, root, size;
+    uint64_t page, offset;
+    uint8_t descriptor[512];
+    unsigned slot;
+
+    if (id >= 32 || !vms->iosfc_probe_directory ||
+        (vms->iosfc_probe_directory & 16383) ||
+        !gfx_probe_read_entry(NULL, vms->iosfc_probe_directory,
+                              &directory_entry) || !(directory_entry & 1)) {
+        return false;
+    }
+    page = (uint64_t)(directory_entry >> 2) << 14;
+    if (!page || !gfx_probe_ram_span(page, 16384) ||
+        address_space_read(&address_space_memory, page + id * 512,
+                           MEMTXATTRS_UNSPECIFIED, descriptor,
+                           sizeof(descriptor)) != MEMTX_OK) {
+        return false;
+    }
+    root = ldl_le_p(descriptor);
+    size = ldl_le_p(descriptor + 16);
+    if (!size || size > 16 * 1024 * 1024) {
+        return false;
+    }
+    for (offset = 0; offset < size; offset += 16384) {
+        uint64_t physical;
+
+        if (!vmapple_gfx_probe_backing(root, size, offset,
+                gfx_probe_read_entry, NULL, &physical) ||
+            !gfx_probe_ram_span(physical, MIN(UINT64_C(16384), size - offset))) {
+            return false;
+        }
+    }
+    for (slot = 0; slot < ARRAY_SIZE(vms->iosfc_probe_mappings); slot++) {
+        if (vms->iosfc_probe_mappings[slot].valid &&
+            vms->iosfc_probe_mappings[slot].id == id) {
+            return vms->iosfc_probe_mappings[slot].root == root &&
+                   vms->iosfc_probe_mappings[slot].size == size;
+        }
+    }
+    for (slot = 0; slot < ARRAY_SIZE(vms->iosfc_probe_mappings); slot++) {
+        if (!vms->iosfc_probe_mappings[slot].valid) {
+            vms->iosfc_probe_mappings[slot].valid = true;
+            vms->iosfc_probe_mappings[slot].id = id;
+            vms->iosfc_probe_mappings[slot].root = root;
+            vms->iosfc_probe_mappings[slot].size = size;
+            return true;
+        }
+    }
+    return false;
+}
