+/* Resolve a submitted task from the live definition ring without pretending
+ * that ignored object deletions have been executed. No registry or guest writes. */
+static void gfx_probe_submission_segment(VMAppleMachineState *vms,
+                                         const uint8_t *submission)
+{
+    VMAppleGfxProbeChannel *channel = &vms->gfx_probe_channels[1];
+    uint32_t control_offset, producer, task = ldl_le_p(submission + 8);
+    uint8_t bytes[28], descriptor[28], segment[256];
+    uint64_t definition = 0, heap_base = 0, root, physical;
+    uint32_t heap_size = 0;
+    VMAppleGfxProbeResourceDelete deleted[64];
+    unsigned deleted_count = 0;
+    uint64_t gpu = ldq_le_p(submission + 44);
+    uint64_t size = ldq_le_p(submission + 52);
+    uint64_t shared = (uint64_t)vms->gfx_probe_shared_page << 14;
+    VMAppleGfxProbeWalkResult detail;
+
+    if (!size || size > sizeof(segment) || (gpu & 16383) + size > 16384 ||
+        !channel->registered || !gfx_probe_map_first_page(channel) ||
+        !vmapple_gfx_probe_channel(2, &control_offset) ||
+        !gfx_probe_read_entry(NULL, shared + control_offset, &producer) ||
+        producer > 16384 || (producer & 3)) {
+        trace_vmapple_gfx_segment_result(1);
+        return;
+    }
+    if (vms->gfx_probe_task_lifecycle) {
+        VMAppleGfxTaskLifetime *live = vmapple_gfx_lifetime_find(
+            &vms->gfx_probe_lifecycle, task);
+        uint32_t dependency_channel = ldl_le_p(submission);
+        uint32_t dependency_tag = ldl_le_p(submission + 4);
+        uint32_t guest_stamp;
+        uint64_t stamp = ((uint64_t)vms->gfx_probe_fifo_page << 14) + 8;
+
+        if (vms->gfx_probe_lifecycle_poisoned || dependency_channel != 2 ||
+            !dependency_tag || (dependency_tag & 255) ||
+            dependency_tag > vms->gfx_probe_lifecycle_tag ||
+            !gfx_probe_read_entry(NULL, stamp, &guest_stamp) ||
+            guest_stamp != vms->gfx_probe_lifecycle_tag ||
+            !live || !live->live || live->mapper || !live->heap ||
+            gpu > live->extent || size > live->extent - gpu) {
+            trace_vmapple_gfx_segment_result(13);
+            return;
+        }
+        definition = live->root;
+        heap_base = live->heap;
+        heap_size = live->heap_size;
+        deleted_count = vms->gfx_probe_lifecycle.deleted_count;
+        memcpy(deleted, vms->gfx_probe_lifecycle.deleted,
+               deleted_count * sizeof(deleted[0]));
+        trace_vmapple_gfx_submission_generation(task, live->generation,
+                                               dependency_tag);
+    }
+    for (uint32_t cursor = 0; !vms->gfx_probe_task_lifecycle &&
+         cursor + 12 <= producer;) {
+        VMAppleGfxProbeHeader header;
+        uint64_t address = channel->first_page_address + cursor;
+
+        if (!gfx_probe_ram_span(address, 12) ||
+            address_space_read(&address_space_memory, address,
+                MEMTXATTRS_UNSPECIFIED, bytes, 12) != MEMTX_OK ||
+            !vmapple_gfx_probe_decode(bytes, 12, producer - cursor, &header)) {
+            trace_vmapple_gfx_segment_result(2);
+            return;
+        }
+        if (header.opcode == 56 && !header.metadata_count && header.length == 28) {
+            if (!gfx_probe_ram_span(address, 28) ||
+                address_space_read(&address_space_memory, address,
+                    MEMTXATTRS_UNSPECIFIED, bytes, 28) != MEMTX_OK) {
+                return;
+            }
+            if ((ldl_le_p(bytes + 12) >> 1) == task) {
+                uint64_t candidate = (uint64_t)ldl_le_p(bytes + 24) << 14;
+                if ((ldl_le_p(bytes + 12) & 1) ||
+                    (definition && definition != candidate)) {
+                    trace_vmapple_gfx_segment_result(3);
+                    return;
+                }
+                definition = candidate;
+            }
+        }
+        if (header.opcode == 51 && !header.metadata_count && header.length == 24) {
+            if (!gfx_probe_ram_span(address, 24) ||
+                address_space_read(&address_space_memory, address,
+                    MEMTXATTRS_UNSPECIFIED, bytes, 24) != MEMTX_OK) {
+                return;
+            }
+            if (ldl_le_p(bytes + 12) == task) {
+                uint64_t candidate = (uint64_t)ldl_le_p(bytes + 16) << 14;
+                uint32_t extent = ldl_le_p(bytes + 20);
+                if (heap_base && (heap_base != candidate || heap_size != extent)) {
+                    trace_vmapple_gfx_segment_result(6);
+                    return;
+                }
+                heap_base = candidate;
+                heap_size = extent;
+            }
+        }
+        if (header.opcode == 37) {
+            VMAppleGfxProbeResourceDelete deletion;
+
+            if (header.length != 20 || header.metadata_count ||
+                !gfx_probe_ram_span(address, 20) ||
+                address_space_read(&address_space_memory, address,
+                    MEMTXATTRS_UNSPECIFIED, bytes, 20) != MEMTX_OK ||
+                !vmapple_gfx_probe_resource_delete(&header, bytes + 12, 8,
+                    &deletion) || deleted_count == ARRAY_SIZE(deleted)) {
+                trace_vmapple_gfx_segment_result(11);
+                return;
+            }
+            deleted[deleted_count++] = deletion;
+        }
+        cursor += header.length;
+    }
+    if (!definition || !gfx_probe_ram_span(definition, sizeof(descriptor)) ||
+        address_space_read(&address_space_memory, definition,
+            MEMTXATTRS_UNSPECIFIED, descriptor, sizeof(descriptor)) != MEMTX_OK ||
+        !vmapple_gfx_probe_table_descriptor(descriptor, sizeof(descriptor), &root)) {
+        trace_vmapple_gfx_segment_result(4);
+        return;
+    }
+    if (!vmapple_gfx_probe_translate_detail(root, gpu, gfx_probe_read_entry,
+            NULL, &physical, &detail) || !gfx_probe_ram_span(physical, size) ||
+        address_space_read(&address_space_memory, physical,
+            MEMTXATTRS_UNSPECIFIED, segment, size) != MEMTX_OK) {
+        trace_vmapple_gfx_segment_result(5);
+        return;
+    }
+    trace_vmapple_gfx_segment_result(0);
+    /* A buffer resource occupies a 12-byte heap slot: type/size, GPU pointer. */
+    if (size == 40 && ldl_le_p(segment) == 40 &&
+        ldl_le_p(segment + 4) == 2 && ldl_le_p(segment + 8) == 0x132 &&
+        ldl_le_p(segment + 12) == 32) {
+        uint32_t resource = ldl_le_p(segment + 16);
+        uint64_t slot_offset = (uint64_t)resource * 12;
+
+        /* Conservative until resource generation/redefinition is modeled:
+         * never use a resource named by any pending deletion in this ring. */
+        for (unsigned i = 0; i < deleted_count; i++) {
+            if (deleted[i].task == task && deleted[i].resource == resource) {
+                trace_vmapple_gfx_segment_result(12);
+                return;
+            }
+        }
+        uint8_t slot[12], buffer[16];
+        uint64_t slot_gpu, object_gpu;
+
+        if (!heap_base || heap_size > 16 * 1024 * 1024 ||
+            slot_offset + sizeof(slot) > heap_size) {
+            trace_vmapple_gfx_segment_result(7);
+            return;
+        }
+        slot_gpu = heap_base + slot_offset;
+        if ((slot_gpu & 16383) + sizeof(slot) > 16384 ||
+            !vmapple_gfx_probe_translate(root, slot_gpu, gfx_probe_read_entry,
+                NULL, &physical) || !gfx_probe_ram_span(physical, sizeof(slot)) ||
+            address_space_read(&address_space_memory, physical,
+                MEMTXATTRS_UNSPECIFIED, slot, sizeof(slot)) != MEMTX_OK) {
+            trace_vmapple_gfx_segment_result(8);
+            return;
+        }
+        for (unsigned pos = 0; pos < sizeof(slot); pos += 4) {
+            trace_vmapple_gfx_resource_word(0, pos, ldl_le_p(slot + pos));
+        }
+        object_gpu = ldq_le_p(slot + 4);
+        if (slot[0] != 1 || (ldl_le_p(slot) >> 8) != sizeof(buffer) ||
+            (object_gpu & 16383) + sizeof(buffer) > 16384 ||
+            !vmapple_gfx_probe_translate(root, object_gpu, gfx_probe_read_entry,
+                NULL, &physical) || !gfx_probe_ram_span(physical, sizeof(buffer)) ||
+            address_space_read(&address_space_memory, physical,
+                MEMTXATTRS_UNSPECIFIED, buffer, sizeof(buffer)) != MEMTX_OK) {
+            trace_vmapple_gfx_segment_result(9);
+            return;
+        }
+        for (unsigned pos = 0; pos < sizeof(buffer); pos += 4) {
+            trace_vmapple_gfx_resource_word(1, pos, ldl_le_p(buffer + pos));
+        }
+        VMAppleGfxProbeFill fill;
+        uint64_t backing = (uint64_t)ldl_le_p(buffer + 8) << 14;
+        uint32_t first_word;
+
+        if (ldl_le_p(buffer + 12) || !backing ||
+            !vmapple_gfx_probe_fill(segment, size, ldq_le_p(buffer), &fill) ||
+            backing > UINT64_MAX - fill.offset ||
+            ((backing + fill.offset) & 16383) + fill.length > 16384 ||
+            !vmapple_gfx_probe_translate(root, backing + fill.offset,
+                gfx_probe_read_entry, NULL, &physical) ||
+            !gfx_probe_ram_span(physical, fill.length) ||
+            !gfx_probe_read_entry(NULL, physical, &first_word)) {
+            trace_vmapple_gfx_segment_result(10);
+            return;
+        }
+        trace_vmapple_gfx_resource_word(2, 0, first_word);
+        /* Explicit diagnostic intervention only: dependency scheduling is not
+         * implemented, so never advance consumer, stamp, or signal completion. */
+        bool ordered = vms->gfx_probe_fill_complete &&
+            vms->gfx_probe_task_lifecycle && !vms->gfx_probe_lifecycle_poisoned &&
+            vms->gfx_probe_fill_control && !vms->gfx_probe_fill_poisoned &&
+            vmapple_gfx_probe_single_submission(submission, 60,
+                vms->gfx_probe_lifecycle_tag, vms->gfx_probe_lifecycle_tag);
+        if ((vms->gfx_probe_fill_effect || ordered) &&
+            (ordered || !vms->gfx_probe_fill_effect_saved)) {
+            uint8_t expected[4096], check[4096];
+            bool verified;
+
+            if (!gfx_probe_save_ram(physical,
+                    vms->gfx_probe_fill_effect_original, fill.length)) {
+                return;
+            }
+            vms->gfx_probe_fill_effect_saved = true;
+            memset(expected, fill.value, fill.length);
+            verified = address_space_write(&address_space_memory, physical,
+                MEMTXATTRS_UNSPECIFIED, expected, fill.length) == MEMTX_OK &&
+                address_space_read(&address_space_memory, physical,
+                    MEMTXATTRS_UNSPECIFIED, check, fill.length) == MEMTX_OK &&
+                memcmp(expected, check, fill.length) == 0;
+            if (!verified) {
+                address_space_write(&address_space_memory, physical,
+                    MEMTXATTRS_UNSPECIFIED, vms->gfx_probe_fill_effect_original,
+                    fill.length);
+            }
+            if (!ordered) {
+                trace_vmapple_gfx_fill_effect(verified, fill.length);
+            }
+            if (verified && ordered) {
+                uint8_t original[8], value[4];
+                uint32_t consumer;
+                uint64_t stamp;
+                uint64_t control = vms->gfx_probe_fill_control;
+                bool completed = false;
+                if (vmapple_gfx_probe_channel_stamp(
+                        (uint64_t)vms->gfx_probe_fifo_page << 14, 1, &stamp) &&
+                    gfx_probe_read_entry(NULL, control + 4, &consumer) &&
+                    consumer == vms->gfx_probe_fill_cursor &&
+                    gfx_probe_save_ram(control + 4, original, 4) &&
+                    gfx_probe_save_ram(stamp, original + 4, 4)) {
+                    stl_le_p(value, consumer + vms->gfx_probe_fill_command_length);
+                    if (gfx_probe_write_verify(control + 4, value, 4)) {
+                        stl_le_p(value, vms->gfx_probe_fill_tag + 256);
+                        completed = gfx_probe_write_verify(stamp, value, 4);
+                    }
+                    if (!completed) {
+                        gfx_probe_write_verify(control + 4, original, 4);
+                        gfx_probe_write_verify(stamp, original + 4, 4);
+                    }
+                }
+                vms->gfx_probe_fill_poisoned = !completed;
+                if (completed) {
+                    vms->gfx_probe_fill_cursor += vms->gfx_probe_fill_command_length;
+                    vms->gfx_probe_fill_tag += 256;
+                }
+                trace_vmapple_gfx_fill_complete(completed, fill.length);
+                if (completed) {
+                    vms->gfx_probe_stamp_pending |= 1 << 1;
+                    if (vms->gfx_probe_root_wake) {
+                        qemu_irq_pulse(qdev_get_gpio_in(vms->gic,
+                            vms->irqmap[VMAPPLE_APV_GFX]));
+                    }
+                }
+            }
+        }
+    }
+    for (unsigned pos = 0; pos + 4 <= size; pos += 4) {
+        trace_vmapple_gfx_segment_word(pos, ldl_le_p(segment + pos));
+    }
+}
