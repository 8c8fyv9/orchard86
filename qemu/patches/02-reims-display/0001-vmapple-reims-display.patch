diff --git a/hw/vmapple/reims-display-identity.h b/hw/vmapple/reims-display-identity.h
new file mode 100644
index 00000000..abc1ff35
--- /dev/null
+++ b/hw/vmapple/reims-display-identity.h
@@ -0,0 +1,28 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef VMAPPLE_REIMS_DISPLAY_IDENTITY_H
+#define VMAPPLE_REIMS_DISPLAY_IDENTITY_H
+
+#include <stdint.h>
+#include <stdbool.h>
+#include <string.h>
+
+/* A host-owned persistent seed; zero keeps the unspecified legacy identity. */
+static inline bool reims_display_identity(uint64_t seed, unsigned port,
+                                          uint8_t uuid[16])
+{
+    memset(uuid, 0, 16);
+    if (!seed || port >= 8) {
+        return false;
+    }
+    uuid[0] = 0x72;
+    uuid[1] = 0x76;
+    uuid[2] = 0x67;
+    uuid[6] = 0x40;
+    uuid[8] = 0x80;
+    for (unsigned byte = 0; byte < 8; byte++) {
+        uuid[3 + byte + (byte >= 3) + (byte >= 4)] = seed >> (56 - byte * 8);
+    }
+    uuid[15] = port + 1;
+    return true;
+}
+#endif
