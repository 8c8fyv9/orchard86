+static bool gfx_probe_complete_root(VMAppleMachineState *vms)
+{
+    uint64_t address;
+    uint8_t stamp[4], readback[4];
+    MemoryRegionSection section;
+    bool writable;
+
+    if (!vms->gfx_probe_root_complete || vms->gfx_probe_stamp_saved ||
+        vms->gfx_probe_root_prefix.failed ||
+        vms->gfx_probe_root_prefix.count != 7 ||
+        vms->gfx_probe_root_prefix.bytes != 140 ||
+        !vmapple_gfx_probe_root_stamp(vms->gfx_probe_fifo_page, 0x700, &address)) {
+        return false;
+    }
+    section = memory_region_find(get_system_memory(), address, 4);
+    writable = section.mr && memory_region_is_ram(section.mr) &&
+               !memory_region_is_rom(section.mr) && !section.readonly &&
+               int128_get64(section.size) >= 4;
+    if (section.mr) {
+        memory_region_unref(section.mr);
+    }
+    if (!writable || address_space_read(&address_space_memory, address,
+            MEMTXATTRS_UNSPECIFIED, vms->gfx_probe_stamp_original, 4) != MEMTX_OK) {
+        return false;
+    }
+    vms->gfx_probe_stamp_address = address;
+    vms->gfx_probe_stamp_saved = true;
+    stl_le_p(stamp, 0x700);
+    vms->gfx_probe_stamp_verified =
+        address_space_write(&address_space_memory, address,
+                            MEMTXATTRS_UNSPECIFIED, stamp, 4) == MEMTX_OK &&
+        address_space_read(&address_space_memory, address,
+                           MEMTXATTRS_UNSPECIFIED, readback, 4) == MEMTX_OK &&
+        memcmp(stamp, readback, 4) == 0;
+    if (vms->gfx_probe_stamp_verified) {
+        vms->gfx_probe_consumer = 140;
+        if (vms->gfx_probe_root_wake) {
+            vms->gfx_probe_stamp_pending = 1;
+            qemu_irq_pulse(qdev_get_gpio_in(vms->gic,
+                                           vms->irqmap[VMAPPLE_APV_GFX]));
+            trace_vmapple_gfx_root_wake();
+        }
+    }
+    return vms->gfx_probe_stamp_verified;
+}
