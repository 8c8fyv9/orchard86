+static bool gfx_probe_validate_heap(VMAppleMachineState *vms,
+                                     const VMAppleGfxProbeHeap *heap)
+{
+    uint64_t offset, root;
+    unsigned reads = 0;
+    uint64_t descriptor_address =
+        vms->gfx_probe_address_spaces[heap->address_space_id].root_address;
+    uint8_t descriptor[28];
+
+    if (!vmapple_gfx_probe_uses_table(
+            &vms->gfx_probe_address_spaces[heap->address_space_id])) {
+        /* Separate mapper service is not implemented by the table walker. */
+        trace_vmapple_gfx_walk_stage(20, 0);
+        return false;
+    }
+    if (!gfx_probe_ram_span(descriptor_address, sizeof(descriptor)) ||
+        address_space_read(&address_space_memory, descriptor_address,
+                           MEMTXATTRS_UNSPECIFIED, descriptor,
+                           sizeof(descriptor)) != MEMTX_OK) {
+        trace_vmapple_gfx_walk_stage(1, 0);
+        return false;
+    }
+    trace_vmapple_gfx_walk_descriptor(ldl_le_p(descriptor),
+                                      ldl_le_p(descriptor + 4));
+    if (!vmapple_gfx_probe_table_descriptor(descriptor, sizeof(descriptor), &root) ||
+        !gfx_probe_ram_span(root, 16384)) {
+        trace_vmapple_gfx_walk_stage(2, 0);
+        return false;
+    }
+    for (offset = 0; offset < heap->size; offset += 16384) {
+        uint64_t physical;
+        VMAppleGfxProbeWalkResult detail;
+        uint64_t length = MIN(UINT64_C(16384), heap->size - offset);
+
+        if (!vmapple_gfx_probe_translate_detail(root, heap->gpu_address + offset,
+                                                gfx_probe_read_entry, &reads,
+                                                &physical, &detail)) {
+            trace_vmapple_gfx_walk_stage(10 + detail.stage, offset);
+            return false;
+        }
+        if (!gfx_probe_ram_span(physical, length)) {
+            trace_vmapple_gfx_walk_stage(4, offset);
+            return false;
+        }
+    }
+    return true;
+}
