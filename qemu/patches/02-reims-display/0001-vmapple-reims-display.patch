+/* Validate a single RAM region, never dispatch reads into MMIO devices. */
+static bool gfx_probe_ram_span(hwaddr address, uint64_t length)
+{
+    MemoryRegionSection section;
+    bool valid;
+
+    if (!length || address > UINT64_MAX - length) {
+        return false;
+    }
+    section = memory_region_find(get_system_memory(), address, length);
+    valid = section.mr && memory_region_is_ram(section.mr) &&
+            int128_get64(section.size) >= length;
+    if (section.mr) {
+        memory_region_unref(section.mr);
+    }
+    return valid;
+}
+
+static bool gfx_probe_read_entry(void *opaque, uint64_t address, uint32_t *entry)
+{
+    uint8_t bytes[4];
+
+    if (!gfx_probe_ram_span(address, sizeof(bytes)) ||
+        address_space_read(&address_space_memory, address,
+                           MEMTXATTRS_UNSPECIFIED, bytes, sizeof(bytes)) !=
+                           MEMTX_OK) {
+        return false;
+    }
+    *entry = ldl_le_p(bytes);
+    if (opaque) {
+        unsigned *count = opaque;
+
+        if ((*count)++ < 2) {
+            trace_vmapple_gfx_walk_entry(*count, address, *entry);
+        }
+    }
+    return true;
+}
