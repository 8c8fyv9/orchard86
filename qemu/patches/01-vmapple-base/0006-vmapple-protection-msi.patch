diff --git a/hw/vmapple/protection-diagnostic.inc.c b/hw/vmapple/protection-diagnostic.inc.c
new file mode 100644
index 0000000..a8135f0
--- /dev/null
+++ b/hw/vmapple/protection-diagnostic.inc.c
@@ -0,0 +1,122 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Local range-bank enforcement experiment. Default diagnostic mode has no
+ * capability header. Recovery opt-in exposes experimental geometry backed by
+ * actual readonly mappings; full permission-bit compatibility is not claimed.
+ * Endpoints are byte-inclusive, or inclusive page bases under explicit opt-in.
+ */
+static bool diagnostic_bank_slot(hwaddr offset, unsigned *slot, unsigned *field)
+{
+    if (offset < 0x40 || offset >= 0x140 || (offset & 7)) {
+        return false;
+    }
+    *slot = (offset - 0x40) / 0x20;
+    *field = ((offset - 0x40) % 0x20) / 8;
+    return *field < 3;
+}
+
+static uint64_t diagnostic_bank_read(void *opaque, hwaddr offset, unsigned size)
+{
+    VMAppleMachineState *vms = opaque;
+    unsigned slot, field;
+    if (vms->recovery_protection && offset < 0x40) {
+        uint64_t base = vms->memmap[VMAPPLE_MEM].base;
+        switch (offset) {
+        case 0: return 0x63747272;
+        case 4: return 1;
+        case 0xc: return 8; /* Actual total implemented slots. */
+        case 0x10: return 14; /* Actual protection granularity. */
+        case 0x20: return base;
+        case 0x28: return base + MACHINE(vms)->ram_size - 0x4000;
+        default: return 0;
+        }
+    }
+    if (!diagnostic_bank_slot(offset, &slot, &field)) {
+        return 0;
+    }
+    return vms->diagnostic_bank_regs[slot][field];
+}
+
+static void diagnostic_bank_write(void *opaque, hwaddr offset,
+                                  uint64_t value, unsigned size)
+{
+    VMAppleMachineState *vms = opaque;
+    MachineState *machine = MACHINE(vms);
+    unsigned slot, field;
+    uint64_t *r, base, start, end, length;
+
+    if (size != 8 || !diagnostic_bank_slot(offset, &slot, &field)) {
+        return;
+    }
+    r = vms->diagnostic_bank_regs[slot];
+    if (r[2] == 7) {
+        return; /* Local immutable commit; host toggle is not exposed here. */
+    }
+    if (field != 2) {
+        r[field] = value;
+        return;
+    }
+    if (value != 7) {
+        return;
+    }
+    base = vms->memmap[VMAPPLE_MEM].base;
+    start = r[0];
+    end = r[1];
+    if (vms->recovery_protection) {
+        if ((end & 0x3fff) || end > UINT64_MAX - 0x3fff) {
+            return;
+        }
+        end += 0x3fff;
+    }
+    if (start < base || end < start || end == UINT64_MAX ||
+        start - base >= machine->ram_size ||
+        end - base >= machine->ram_size ||
+        (start & 0x3fff) || ((end + 1) & 0x3fff)) {
+        return; /* Reject invalid commit without falsely reporting lock. */
+    }
+    length = end - start + 1;
+    memory_region_init_ram_ptr(&vms->diagnostic_bank_views[slot], NULL,
+                               "vmapple-diagnostic-bank", length,
+                               (uint8_t *)memory_region_get_ram_ptr(machine->ram)
+                               + start - base);
+    memory_region_set_readonly(&vms->diagnostic_bank_views[slot], true);
+    memory_region_add_subregion_overlap(get_system_memory(), start,
+                                        &vms->diagnostic_bank_views[slot], 2);
+    r[2] = 7; /* Report only after the real mapping was installed. */
+}
+
+static const MemoryRegionOps diagnostic_bank_ops = {
+    .read = diagnostic_bank_read,
+    .write = diagnostic_bank_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 8,
+               .unaligned = false },
+    .impl = { .min_access_size = 4, .max_access_size = 8 },
+};
+
+static void diagnostic_bank_reset(void *opaque)
+{
+    VMAppleMachineState *vms = opaque;
+    memory_region_transaction_begin();
+    for (unsigned slot = 0; slot < 8; slot++) {
+        if (vms->diagnostic_bank_regs[slot][2] == 7) {
+            memory_region_del_subregion(get_system_memory(),
+                                        &vms->diagnostic_bank_views[slot]);
+            object_unparent(OBJECT(&vms->diagnostic_bank_views[slot]));
+        }
+    }
+    memset(vms->diagnostic_bank_regs, 0, sizeof(vms->diagnostic_bank_regs));
+    memory_region_transaction_commit();
+}
+
+static void create_diagnostic_banks(VMAppleMachineState *vms)
+{
+    if (!vms->recovery_protection) {
+        return;
+    }
+    memory_region_init_io(&vms->diagnostic_bank_mr, OBJECT(vms),
+                          &diagnostic_bank_ops, vms,
+                          "vmapple-diagnostic-range-banks", 0x1000);
+    memory_region_add_subregion(get_system_memory(), 0x30260000,
+                                &vms->diagnostic_bank_mr);
+    qemu_register_reset(diagnostic_bank_reset, vms);
+}
