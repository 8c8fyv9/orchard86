-static void create_rtc(const VMAppleMachineState *vms)
+/* Local compatibility selector: advertises only the PL031 actually realized. */
+static uint64_t vmapple_rtc_selector_read(void *opaque, hwaddr offset,
+                                         unsigned size)
+{
+    VMAppleMachineState *vms = opaque;
+
+    switch (offset) {
+    case 0x00:
+        /* Independent of UTC loads; follows the migratable VM clock. */
+        return qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) / 1000;
+    case 0x18:
+        return vms->recovery_platform_control;
+    case 0x38:
+        return vms->recovery_platform_mask;
+    case 0x40:
+        return 0xf001;
+    default:
+        return 0;
+    }
+}
+
+static void vmapple_rtc_selector_write(void *opaque, hwaddr offset,
+                                      uint64_t value, unsigned size)
+{
+    VMAppleMachineState *vms = opaque;
+    uint64_t mask = size == 8 ? UINT64_MAX : UINT32_MAX;
+
+    /* Configuration storage only. No host events or synthetic completions. */
+    switch (offset) {
+    case 0x18:
+        vms->recovery_platform_control =
+            (vms->recovery_platform_control & ~mask) | (value & mask);
+        break;
+    case 0x38:
+        vms->recovery_platform_mask =
+            (vms->recovery_platform_mask & ~mask) | (value & mask);
+        break;
+    }
+}
+
+static const MemoryRegionOps vmapple_rtc_selector_ops = {
+    .read = vmapple_rtc_selector_read,
+    .write = vmapple_rtc_selector_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .impl = { .min_access_size = 4, .max_access_size = 8 },
+    .valid = { .min_access_size = 4, .max_access_size = 8,
+               .unaligned = false },
+};
+
+static void create_rtc(VMAppleMachineState *vms)
 {
     hwaddr base = vms->memmap[VMAPPLE_RTC].base;
     int irq = vms->irqmap[VMAPPLE_RTC];
 
     sysbus_create_simple("pl031", base, qdev_get_gpio_in(vms->gic, irq));
+    if (vms->recovery_rtc_selector) {
+        memory_region_init_io(&vms->rtc_selector_mr, OBJECT(vms),
+                              &vmapple_rtc_selector_ops, vms,
+                              "vmapple-rtc-selector", 0x1000);
+        memory_region_add_subregion(get_system_memory(), 0x30240000,
+                                    &vms->rtc_selector_mr);
+    }
 }
 
