 static const char *virtio_id_to_name(uint16_t device_id)
 {
+    /* VMApple USB uses a private identifier outside the standard ID table. */
+    if (device_id == 0x1a01) {
+        return "vmapple-virtio-usb";
+    }
     assert(device_id < G_N_ELEMENTS(virtio_device_names));
